#!/usr/bin/env python3
"""refusal-improve: turn the GitHub agents' refused shell calls into rules in their prompts, and
measure the rules already there (docs/plans/2026-11-24-probe-loop.md, the improver's first step).

  python3 -I bin/refusal-improve --repo OWNER/NAME [--root DIR] [--days D] [--min N] [--now ISO-TIME]
                                 [--write] [--body FILE]

Reads, with the publishable key in AGENT_TRANSCRIPTS_INSERT_KEY, the store's report functions
(store/schema.sql) for the repository: each call an agent's allowlist refused in the last D days
(default 28), with the session it was in (agent_refused_calls; where the store has not that
function yet, agent_refused_commands, the commands without their sessions), and its runs. Each refused command is sorted by what was tried, as the weekly
report sorts it (bin/probe-report). No model is involved.

For an agent whose prompt can be told what to do instead (a compound command, cd, an
environment variable set in the command, the safeoutputs command, a script of its own) and
that was refused that way at least N times (default 2), it adds one fixed rule to the "Shell
calls" section at the end of the agent's workflow source (.github/workflows/<file>.md, found by
the workflow's name), between the BEGIN and END refusal-improver lines it keeps there. A rule
already there is not added again; nothing is ever taken out. Some refusals also get a rule that
names what to do instead, a command the agent's allowlist already has (HINTS: jq for JSON, a
test's full path, a test run again as separate calls, a file given to head): one refusal is
enough for those, and each is added only when the allowlist does hold that command. Without --write it changes
nothing and says what it would change.

It never edits an allowlist. A test file not on main's list, a bin/ tool or another program is
listed for a person to decide, one row per program (a git subcommand or flag, as `git -C`, is a
program of its own), leaving out what the agent's allowlist allows by now: the allowlists are kept narrow on purpose (each one's comments
say why), and a wider one could let an agent run what it must not.

For each rule already on main, it compares the agent's refusals of that kind per run in the 14
days before the rule reached main (the first-parent commit that added it, so the checkout needs
its history) with the time since.

Prints the files it changed (or would change), one per line. --body FILE writes the markdown
for the pull request: a summary, each rule added written out once with its evidence, the
allowlist candidates and the measurements, each example linked to the GitHub run it came from. The store is AGENT_TRANSCRIPTS_URL (https only, but for 127.0.0.1 or localhost),
and a redirect is refused. Exit 0; 1 the store or git failed; 2 usage.
"""
import datetime as dt
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
from urllib.parse import urlsplit

HERE = os.path.dirname(os.path.realpath(__file__))
_loader = importlib.machinery.SourceFileLoader("probe_report", os.path.join(HERE, "probe-report"))
_spec = importlib.util.spec_from_loader("probe_report", _loader)
report = importlib.util.module_from_spec(_spec)
_loader.exec_module(report)

# What each kind of refusal is told in the prompt. Each rule only narrows what the agent does.
RULES = {  # the kinds of refusal; the hints' rules are added to these below
    "compound": "Every command in a call must be one of your assigned commands, each part joined with `&&`, `;`, "
                "`||` or a pipe included; loops (`for`, `while`), subshells and `$(...)` are refused. When a step "
                "needs more than that, make it separate calls.",
    "env": "Do not set environment variables in a command (`VAR=value command`, `export`): this workflow sets the "
           "environment you need, `TMPDIR` included.",
    "cd": "Do not run `cd`: give each command full paths instead.",
    "safeoutputs": "Call the safe-output tools (such as `add_comment`, `create_issue` and `noop`) as tools; the "
                   "`safeoutputs` shell command is refused.",
    "own": "Do not write a script and run it: run your assigned commands directly, one call each.",
}
KINDS = ["compound", "env", "cd", "safeoutputs", "own"]
FOR_A_PERSON = {"test", "tool", "program"}
BEGIN = "<!-- BEGIN refusal-improver: bin/refusal-improve keeps this section; it adds rules and removes none -->"
END = "<!-- END refusal-improver -->"
MARK = "<!-- rule: {} -->"
BEFORE = dt.timedelta(days=14)


class Failed(Exception):
    pass


TITLES = {"compound": "Compound commands", "env": "Environment variables set in a command", "cd": "Running cd",
          "safeoutputs": "The safeoutputs shell command", "own": "Running a script of its own"}
WITH_ARG = ("git", "gh", "npm", "pnpm", "cargo", "go", "docker")


def test_entries(patterns):
    return [p for p in patterns if re.fullmatch(r"bash /\S+\.test\.sh", p)]


# "Use this instead": a rule that names a command the agent is already allowed, for a refusal
# that has one. Each says what it detects, what the allowlist must already hold for the rule to be
# true, and the rule. One refusal is enough for these, as each only points at an allowed command.
HINTS = {
    "use-jq": {
        "title": "Reading JSON",
        "rule": "Read JSON files with `jq` (for example `jq '.jobs' FILE`): `python3` is not one of your commands.",
        "match": lambda c: re.search(r"\bpython3?\b", c) is not None and "json" in c.lower(),
        "needs": lambda ps: allowed("jq .", ps)},
    "full-path": {
        "title": "Running tests",
        "rule": "Run a test file by the full path on your list, as `bash /tmp/gh-aw/...`; a relative path, or one "
                "run after `cd`, is refused.",
        "match": lambda c: re.search(r"(^|[;&|]\s*)bash\s+(?!/)\S+\.test\.sh", c) is not None,
        "needs": lambda ps: bool(test_entries(ps))},
    "rerun": {
        "title": "Checking whether a test is flaky",
        "rule": "To see whether a test fails every time, run it again as separate calls, up to three; a loop is "
                "refused.",
        "match": lambda c: re.search(r"\b(for|while)\b.*\.test\.sh", c) is not None,
        "needs": lambda ps: bool(test_entries(ps))},
    "head-file": {
        "title": "Reading part of a file",
        "rule": "Give the file to `head`, `tail` or `grep` itself (`head -n 50 FILE`), rather than piping `cat` into "
                "them.",
        "match": lambda c: re.search(r"\bcat\s+[^|;&]+\|\s*(head|tail|grep)\b", c) is not None,
        "needs": lambda ps: any(allowed(f"{t} x", ps) for t in ("head", "tail", "grep"))},
}
ORDER = KINDS + list(HINTS)
RULES.update({k: h["rule"] for k, h in HINTS.items()})
TITLES.update({k: h["title"] for k, h in HINTS.items()})


def program(command, kind, prog):
    """What an allowlist would have to allow for a refused command: the test file, the bin/ tool,
    or the program with its subcommand or first flag (git -C, git log, python3 -m venv)."""
    words = command.split()
    if kind == "test":
        return " ".join(words[:2])
    if kind == "tool":
        return f"bash {prog}"
    if not words:
        return "?"
    out = words[:1]
    if len(words) > 1 and (words[1].startswith("-") or words[0] in WITH_ARG):
        out.append(words[1])
        if words[1] == "-m" and len(words) > 2:
            out.append(words[2])
    return " ".join(out)


def allowlist(text):
    """The Bash patterns in a workflow source's frontmatter (tools.bash)."""
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    found, inside = [], False
    for line in (m.group(1) if m else "").split("\n"):
        if re.match(r"^  bash:\s*$", line):
            inside = True
            continue
        if inside:
            item = re.match(r'^\s+-\s+"(.*)"\s*$', line)
            if item:
                found.append(item.group(1))
            elif line.strip() and not line.lstrip().startswith("#"):
                if len(line) - len(line.lstrip()) <= 2:
                    break
    return found


def allowed(command, patterns):
    for p in patterns:
        if p.endswith(":*"):
            if command == p[:-2] or command.startswith(p[:-2] + " "):
                return True
        elif command == p:
            return True
    return False


def run_link(repo, session):
    m = re.fullmatch(r"gh-aw-.+-([0-9]+)-([0-9]+)", session or "")
    return f"https://github.com/{repo}/actions/runs/{m.group(1)}/attempts/{m.group(2)}" if m else None


def git(root, *args):
    out = subprocess.run(["git", "-C", root, *args], capture_output=True, text=True)
    if out.returncode != 0:
        raise Failed(f"git {' '.join(args[:2])}: {out.stderr.strip()[:200]}")
    return out.stdout


def agents(root):
    """agent slug (as bin/agent-session-collect names sessions) -> its workflow source."""
    found = {}
    wf = os.path.join(root, ".github", "workflows")
    for f in sorted(os.listdir(wf)):
        if not f.endswith(".md"):
            continue
        text = open(os.path.join(wf, f), encoding="utf-8").read()
        m = re.match(r"---\n(.*?)\n---\n", text, re.S)
        name = re.search(r"^name:\s*(.+?)\s*$", m.group(1), re.M) if m else None
        if name:
            found[re.sub(r"[^a-z0-9]+", "-", name.group(1).strip("'\"").lower()).strip("-")[:40].strip("-")] = \
                os.path.join(".github", "workflows", f)
    return found


def rules_in(text):
    if BEGIN not in text and END not in text:
        return []
    if text.count(BEGIN) != 1 or text.count(END) != 1 or text.index(END) < text.index(BEGIN):
        raise Failed("the refusal-improver section is not one BEGIN line followed by one END line")
    block = text.split(BEGIN, 1)[1].split(END, 1)[0]
    return [k for k in ORDER if MARK.format(k) in block]


def with_rules(text, kinds):
    """The source with the Shell calls section holding these rules, in their order."""
    lines = "\n".join(f"- {RULES[k]} {MARK.format(k)}" for k in ORDER if k in kinds)
    section = f"{BEGIN}\n## Shell calls\n\n{lines}\n{END}\n"
    rules_in(text)  # stops on a section that is not one BEGIN and one END
    if BEGIN in text:
        head, rest = text.split(BEGIN, 1)
        return head + section + rest.split(END, 1)[1].lstrip("\n")
    return text.rstrip("\n") + "\n\n" + section


def landed(root, path, kind):
    """When the rule reached main: the first-parent commit that added its mark, or None."""
    out = git(root, "log", "--first-parent", "--reverse", "--format=%cI", "-S", MARK.format(kind), "HEAD", "--", path)
    first = out.split()
    return dt.datetime.fromisoformat(first[0]) if first else None


def and_list(items):
    items = list(items)
    return items[0] if len(items) == 1 else ", ".join(items[:-1]) + (", and " if len(items) > 2 else " and ") + items[-1]


def example(repo, command, session, width=160):
    """An example refused command, cut to its first WIDTH characters, linked to its run."""
    shown = command if len(command) <= width else command[:width].rstrip() + "..."
    link = run_link(repo, session)
    return report.code(shown) + (f" ([run]({link}))" if link else "")


def body(repo, days, least, added, candidates, measured, allowed_now):
    """The pull request's text: what it does first, then each rule once with its evidence."""
    kinds = sorted({k for _, k, _ in added}, key=ORDER.index)
    agents_ = sorted({a for a, _, _ in added})
    said = []
    if added:
        said.append(f"adds {len(added)} rule{'s' if len(added) != 1 else ''} to the prompt"
                    f"{'s' if len(agents_) != 1 else ''} of {and_list(agents_)}")
    if candidates:
        said.append(f"lists {len(candidates)} allowlist candidate{'s' if len(candidates) != 1 else ''} for you to decide")
    if measured:
        said.append(f"measures {len(measured)} rule{'s' if len(measured) != 1 else ''} already in place")
    out = [("This " + (said[0] if len(said) == 1 else ", ".join(said[:-1]) + ", and " + said[-1]) + ".") if said
           else "No refused calls to act on.", "",
           f"From the GitHub agents' refused shell calls in {repo} over the last {days} days, in the transcript store. "
           "Written by `bin/refusal-improve` with fixed rules: no model is involved, and a person merges it or not.", ""]
    if added:
        out += ["## Rules added to the agents' prompts", "",
                f"Each goes in the \"Shell calls\" section at the end of the agent's prompt, for a kind of call the agent "
                f"was refused at least {least} times, or once for a rule that names a command its allowlist already "
                "has. A rule only narrows what the agent does, or points at what it may do instead.", ""]
        for k in kinds:
            out += [f"### {TITLES[k]}", "", "> " + RULES[k], ""]
            for a, kk, g in added:
                if kk == k:
                    out.append(f"- **{report.cell(a)}**: refused {'once' if g['n'] == 1 else str(g['n']) + ' times'}, such as "
                               + "; ".join(example(repo, c, sid) for c, sid in g["examples"]))
            out.append("")
        out += ["Each rule is measured once it is on main: the agent's refusals of that kind per run, against the 14 days "
                "before. One that does not help is reported as such.", ""]
    if candidates:
        out += ["## For you to decide: allowlist candidates", "",
                "Not edited. The allowlists are kept narrow on purpose, and each one's comments say why: widen one only if "
                "the agent needs it and it cannot be used to run something it must not.", "",
                "| Agent | Would need | Refused | Such as |", "|---|---|---|---|"]
        out += [f"| {report.cell(a)} | {report.code(prog)} | {g['n']} | {example(repo, g['examples'][0][0], g['examples'][0][1], 100)} |"
                for a, _, prog, g in candidates]
        if allowed_now:
            out += ["", "Left out, as the agent's allowlist allows them by now: "
                    + ", ".join(f"{report.code(prog)} ({report.cell(a)})" for a, prog in allowed_now) + "."]
        out.append("")
    if measured:
        out += ["## Rules already in place", "",
                "| Agent | Rule | On main since | 14 days before | Since | Result |", "|---|---|---|---|---|---|"]
        out += [f"| {report.cell(a)} | {TITLES[k]} | {w.date()} | {b} in {br} runs | {x} in {xr} runs | {v} |"
                for a, k, w, b, br, x, xr, v in measured]
        out.append("")
    return "\n".join(out).rstrip("\n") + "\n"


def main(argv):
    opts, it = {}, iter(argv[1:])
    try:
        for a in it:
            if a == "--write" and a not in opts:
                opts[a] = True
            elif a in ("--repo", "--root", "--days", "--min", "--now", "--body") and a not in opts:
                opts[a] = next(it)
            else:
                raise ValueError(a)
        repo = opts["--repo"]
        if not re.fullmatch(r"[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}", repo):
            raise ValueError("repo")
        days, least = int(opts.get("--days", 28)), int(opts.get("--min", 2))
        if not 1 <= days <= 366 or not 1 <= least <= 100:
            raise ValueError("days or min")
        now = dt.datetime.fromisoformat(opts["--now"].replace("Z", "+00:00")) if "--now" in opts \
            else dt.datetime.now(dt.timezone.utc)
        if now.tzinfo is None:
            raise ValueError("--now needs a time zone")
        root = os.path.abspath(opts.get("--root", "."))
    except (StopIteration, KeyError, ValueError):
        print("usage: refusal-improve --repo OWNER/NAME [--root DIR] [--days D] [--min N] [--now ISO-TIME] [--write] "
              "[--body FILE]", file=sys.stderr)
        return 2
    url = (os.environ.get("AGENT_TRANSCRIPTS_URL") or "").rstrip("/")
    key = os.environ.get("AGENT_TRANSCRIPTS_INSERT_KEY") or ""
    u = urlsplit(url)
    if not key or not (u.scheme == "https" or (u.scheme == "http" and u.hostname in ("127.0.0.1", "localhost"))):
        print("refusal-improve: AGENT_TRANSCRIPTS_URL (https) and AGENT_TRANSCRIPTS_INSERT_KEY are both needed",
              file=sys.stderr)
        return 2

    def iso(t):
        return t.astimezone(dt.timezone.utc).isoformat(timespec="seconds")

    per_call = [True]  # whether the store has agent_refused_calls

    def refused(since):
        """Refused calls since then: {agent, command, times, session}."""
        if per_call[0]:
            try:
                rows = report.call(url, key, "agent_refused_calls", {"since": iso(since), "max_rows": 1000, "repo": repo})
                if len(rows) == 1000:
                    print(f"refusal-improve: 1000 refused calls since {iso(since)[:10]}, the most it reads: "
                          "counts may be short", file=sys.stderr)
                return [{"agent": r["agent"], "command": r["command"] or "?", "times": 1, "session": r["session_id"]}
                        for r in rows]
            except report.Store as e:
                if "answered 404" not in str(e):
                    raise
                per_call[0] = False
                print("refusal-improve: the store has no agent_refused_calls yet (store/schema.sql): "
                      "the report has no run links", file=sys.stderr)
        rows = report.call(url, key, "agent_refused_commands", {"since": iso(since), "max_rows": 50, "repo": repo})
        if len(rows) == 50:
            print(f"refusal-improve: 50 refused commands since {iso(since)[:10]}, the most the store gives: "
                  "counts may be short", file=sys.stderr)
        return [{"agent": r["agent"], "command": r["command"], "times": r["times"], "session": None} for r in rows]

    def runs(since):
        return {r["agent"]: r["runs"] for r in report.call(url, key, "agent_health", {"since": iso(since), "repo": repo})}

    def matches(command, kind):
        return HINTS[kind]["match"](command) if kind in HINTS else report.tried(command)[0] == kind

    def count(rows, agent, kind):
        return sum(r["times"] for r in rows if r["agent"] == agent and matches(r["command"], kind))

    try:
        files = agents(root)
        recent = refused(now - dt.timedelta(days=days))
        by, progs = {}, {}  # (agent, kind) -> {"n", "examples"}; (agent, program) -> the same, for a person
        for r in recent:
            kind, prog = report.tried(r["command"])
            keys = [(by, (r["agent"], kind))] + [(by, (r["agent"], h)) for h, d in HINTS.items() if d["match"](r["command"])]
            if kind in FOR_A_PERSON:
                keys.append((progs, (r["agent"], kind, program(r["command"], kind, prog))))
            for table, k in keys:
                g = table.setdefault(k, {"n": 0, "examples": []})
                g["n"] += r["times"]
                if len(g["examples"]) < 2 and r["command"] not in [c for c, _ in g["examples"]]:
                    g["examples"].append((r["command"], r["session"]))

        changed, added, candidates, measured, unknown, allowed_now = [], [], [], [], set(), []
        for agent in sorted({a for a, _ in by}):
            path = files.get(agent)
            if not path:
                unknown.add(agent)
                continue
            full = os.path.join(root, path)
            text = open(full, encoding="utf-8").read()
            have = rules_in(text)
            patterns = allowlist(text)
            want = [k for k in ORDER if k not in have and by.get((agent, k), {}).get("n", 0) >= (1 if k in HINTS else least)
                    and (k not in HINTS or HINTS[k]["needs"](patterns))]
            for (a, k, prog), g in sorted(progs.items(), key=lambda kv: (kv[0][0], -kv[1]["n"], kv[0][2])):
                if a != agent:
                    continue
                if all(allowed(c, patterns) for c, _ in g["examples"]):
                    allowed_now.append((a, prog))
                    continue
                candidates.append((a, k, prog, g))
            if want:
                added += [(agent, k, by[(agent, k)]) for k in want]
                changed.append(path)
                if "--write" in opts:
                    new = with_rules(text, set(have) | set(want))
                    with open(full, "w", encoding="utf-8") as f:
                        f.write(new)

        # The rules already on main, each against the 14 days before it landed.
        for agent, path in sorted(files.items()):
            try:
                committed = git(root, "show", f"HEAD:{path}")
            except Failed:
                continue  # not committed yet
            for k in rules_in(committed):
                when = landed(root, path, k)
                if when is None:
                    continue
                before_rows, after_rows = refused(when - BEFORE), refused(when)
                before_runs, after_runs = runs(when - BEFORE), runs(when)
                b = count(before_rows, agent, k) - count(after_rows, agent, k)
                br = before_runs.get(agent, 0) - after_runs.get(agent, 0)
                a, ar = count(after_rows, agent, k), after_runs.get(agent, 0)
                if ar < 3:
                    verdict = "too few runs since to tell"
                elif br == 0 or b == 0:
                    verdict = "fewer" if a == 0 else "no refusals before to compare with"
                elif a / ar <= (b / br) / 2:
                    verdict = "fewer"
                else:
                    verdict = "no better: look at the rule, or whether the allowlist should change"
                measured.append((agent, k, when, b, br, a, ar, verdict))
    except (report.Store, Failed, OSError, UnicodeDecodeError) as e:
        print(f"refusal-improve: {e}", file=sys.stderr)
        return 1
    except (KeyError, TypeError, ValueError) as e:
        print(f"refusal-improve: the store's answer is not what was expected ({type(e).__name__}: {e})", file=sys.stderr)
        return 1

    for a in sorted(unknown):
        print(f"refusal-improve: {a} has refused calls but no workflow source here is named for it", file=sys.stderr)
    for p in changed:
        print(p)

    if "--body" in opts:
        with open(opts["--body"], "w", encoding="utf-8") as f:
            f.write(body(repo, days, least, added, candidates, measured, allowed_now))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
