+import json
 import sys
 
 
@@ -5,10 +6,29 @@ def greet(name):
     return f"Hello, {name}!"
 
 
+def refuse(message):
+    print(f"greet: {message}", file=sys.stderr)
+    return 2
+
+
+FORMATS = ("text", "json")
+
+
 def main(argv):
-    name = argv[1] if len(argv) > 1 else "world"
-    print(greet(name))
+    args = argv[1:]
+    fmt = "text"
+    if "--format" in args:
+        at = args.index("--format")
+        if at + 1 >= len(args):
+            return refuse("--format needs a value: text or json")
+        fmt = args[at + 1]
+        del args[at:at + 2]
+        if fmt not in FORMATS:
+            return refuse(f"unknown format {fmt!r}: use text or json")
+    greeting = greet(args[0] if args else "world")
+    print(json.dumps({"greeting": greeting}) if fmt == "json" else greeting)
+    return 0
 
 
 if __name__ == "__main__":
-    main(sys.argv)
+    sys.exit(main(sys.argv))
diff --git a/tests/test_greet.py b/tests/test_greet.py
index fbe2fbd..ad89c38 100644
--- a/tests/test_greet.py
+++ b/tests/test_greet.py
@@ -6,3 +6,23 @@ from greet import greet
 class Greet(unittest.TestCase):
     def test_greets_by_name(self):
         self.assertEqual(greet("Ada"), "Hello, Ada!")
+
+
+class FormatJson(unittest.TestCase):
+    def run_main(self, *args):
+        from greet import main
+        import contextlib, io
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            rc = main(["greet.py", *args])
+        return rc, out.getvalue(), err.getvalue()
+
+    def test_json_survives_a_quote_and_a_backslash(self):
+        import json
+        rc, out, _ = self.run_main('A"d\\a', "--format", "json")
+        self.assertEqual((rc, json.loads(out)), (0, {"greeting": 'Hello, A"d\\a!'}))
+
+    def test_an_unknown_format_is_refused_with_status_2(self):
+        rc, out, err = self.run_main("Ada", "--format", "xml")
+        self.assertEqual((rc, out), (2, ""))
+        self.assertIn("xml", err)
