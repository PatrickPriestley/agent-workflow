diff --git a/greet.py b/greet.py
index 21b83b0..323ef3d 100644
--- a/greet.py
+++ b/greet.py
@@ -5,10 +5,31 @@ def greet(name):
     return f"Hello, {name}!"
 
 
+def refuse(message):
+    print(f"greet: {message}", file=sys.stderr)
+    return 2
+
+
 def main(argv):
-    name = argv[1] if len(argv) > 1 else "world"
-    print(greet(name))
+    args = argv[1:]
+    count = 1
+    if "-n" in args:
+        at = args.index("-n")
+        if at + 1 >= len(args):
+            return refuse("-n needs a count")
+        text = args[at + 1]
+        del args[at:at + 2]
+        try:
+            count = int(text)
+        except ValueError:
+            return refuse(f"-n needs a whole number, not {text!r}")
+        if count < 0:
+            return refuse(f"-n cannot be negative: {text}")
+    greeting = greet(args[0] if args else "world")
+    for _ in range(count):
+        print(greeting)
+    return 0
 
 
 if __name__ == "__main__":
-    main(sys.argv)
+    sys.exit(main(sys.argv))
diff --git a/tests/test_greet.py b/tests/test_greet.py
index fbe2fbd..dd02dfd 100644
--- a/tests/test_greet.py
+++ b/tests/test_greet.py
@@ -6,3 +6,23 @@ from greet import greet
 class Greet(unittest.TestCase):
     def test_greets_by_name(self):
         self.assertEqual(greet("Ada"), "Hello, Ada!")
+
+
+class Repeat(unittest.TestCase):
+    def run_main(self, *args):
+        from greet import main
+        import contextlib, io
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            rc = main(["greet.py", *args])
+        return rc, out.getvalue(), err.getvalue()
+
+    def test_the_greeting_repeats(self):
+        self.assertEqual(self.run_main("Ada", "-n", "2"), (0, "Hello, Ada!\nHello, Ada!\n", ""))
+        self.assertEqual(self.run_main("Ada", "-n", "0"), (0, "", ""))
+
+    def test_a_count_that_is_no_whole_number_or_negative_is_refused(self):
+        for bad in ("seven", "1.5", "-3"):
+            rc, out, err = self.run_main("Ada", "-n", bad)
+            self.assertEqual((rc, out), (2, ""), bad)
+            self.assertIn("-n", err)
