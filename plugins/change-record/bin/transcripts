#!/usr/bin/env python3
"""transcripts: keep agent session transcripts in a local archive, one index entry per session.

  transcripts archive [--scoped] [--transcript PATH]
  transcripts import [--claude-home DIR] [--repo URL]... [--evals]
  transcripts import [--claude-home DIR] --scoped
  transcripts scope [DIR]
  transcripts push [--session ID]... [--background]
  transcripts materialize DIR [--session ID]... [--repo-dir DIR]
  transcripts messages [--session ID]... [--check]
  transcripts redact < lines > redacted-lines
  transcripts grade [DIR] [--session ID]... [--repo-dir DIR] [--store]
  transcripts grade --transcript FILE [--cwd DIR]
  transcripts sheet [DIR] [--session ID]... [--repo-dir DIR] [--labels DIR]
  transcripts sheet --transcript FILE... --out DIR [--labels DIR]
  transcripts accuracy [DIR] [--labels DIR]
  transcripts accuracy --transcript FILE... [--labels DIR]
  transcripts probe --agent codex|cursor [--out DIR]
  transcripts judge --repeats [DIR] (--session ID... | --limit N) [--again]
  transcripts judge --repeats --transcript FILE... --out DIR [--again]
  transcripts propose [DIR] --session ID --step STEP [--labels DIR] [--repo-dir DIR]
  transcripts judge --review [DIR] (--session ID... | --limit N) [--repo-dir REPO] [--model sonnet|opus] [--again] [--local]

archive is the Stop and SessionEnd hook: it reads the hook's JSON on stdin (session_id,
transcript_path, cwd), or takes --transcript PATH instead, and adds the transcript's new
complete lines, and those of the session's subagent transcripts, to the archive named by
AGENT_TRANSCRIPTS as numbered parts, then writes the session's index entry. With
AGENT_TRANSCRIPTS unset it does nothing. It never fails a session: every problem is a message
on stderr and exit 0, and the lines not archived are archived at the next stop.

archive --scoped is the hook the plugin ships (hooks/hooks.json), which runs in every repository
of whoever installed the plugin: it archives a session only when the repository it is in, and
the one it began in, are on the owner's scope list, <config>/agent-transcripts/scope. One pattern
a line, matched against the whole repository as the index entry names it (github.com/owner/name)
without regard to case, with the shell's wildcards, * crossing /; # starts a comment; !pattern
excludes, and an exclusion wins over any match. With no list, an empty one, no line that matches
or one that excludes, and for a session outside any repository, in one with no origin or one
whose origin is a local path, it archives nothing, starts no push, prints nothing and exits 0.
scope says which of these holds for the repository at DIR (default: here), then how much the
archive on this machine holds; it exits 0 when in scope and 1 when not.

import archives the sessions already under <claude-home>/projects (default ~/.claude) whose
working directory is a checkout of a repository in scope: the current directory's repository,
or each --repo URL; with --scoped, every repository on the scope list instead. --evals also takes
eval-runner sessions. Running it again adds only what is new. It needs AGENT_TRANSCRIPTS set.

The archive:
  sessions/<sessionId>.json                    the index entry (schema 1, below)
  parts/<sessionId>/main/g<G>-<NNNNNN>.jsonl   the transcript's lines, part by part
  parts/<sessionId>/subagents/<agent>/...      each subagent transcript, the same way
  locks/<sessionId>/                           held while one run archives the session

A session is keyed by its transcript's sessionId. A transcript that is no longer an extension of
what was archived (Claude Code only appends, so this should not happen) starts generation G+1
with a full copy. Index entry fields: source (local, cloud, dispatch, eval), machine (a random
id kept in ${XDG_CONFIG_HOME:-~/.config}/agent-transcripts/machine-id; in the cloud the
container id and the cloud session id instead), repository (the normalised origin URL),
first_stop and last_stop (branch and commit; import knows only the branch), first_timestamp and
last_timestamp (from the transcript's own lines), skills (each skill invoked through the Skill
tool or read as a SKILL.md, with the git blob hash of its file when first seen), records
(written by Write or Edit, and named on a Change: line in the session's own text) and record
(the one both agree on, else the only one there is, else none), parent_session (from
AGENT_TRANSCRIPTS_PARENT, which dispatch sets for its children, at the first stop only), streams
(per transcript: generation, parts, lines, bytes, sha256 of what is archived), sent (filled when
push) and redaction_version (the version of the redaction last applied to what was sent;
none until a push: the local archive is never redacted).

push sends to the store at AGENT_TRANSCRIPTS_URL (the Supabase project's URL; https only, but
for 127.0.0.1) what the archive has that the store does not, redacted (REDACTION, below), with
the hooks' insert-only key: the 0600 file <config>/agent-transcripts/insert-key when there is
one, else no key, for a cloud proxy that injects it. Each stream goes as gzip chunks of at most
CHUNK_BYTES, keyed by a hash chain (chunk_id = sha256(start_id ":" sha256(bytes)), from
sha256(sessionId "/" stream)), then the session's redacted index entry as a new row version.
It only inserts: a 409 duplicate means already stored. A stream the archive rewrote, or a new
redaction version, starts a new generation from the chain's root. With AGENT_TRANSCRIPTS_URL set,
the archive hook starts `push --background` detached, which stops after
AGENT_TRANSCRIPTS_PUSH_LIMIT seconds (default 60) and writes to <archive>/push.log; what it did
not send goes at the next stop. After each chunk it sends the chunk's rows for the readable table
(`messages`, below), cut into requests of at most 1,000,000 bytes. Rows never hold back a chunk or
the index row: a request of rows that is refused, or gets no answer, is kept in the session's sent
state as owed, the last line says how many are, and the next push sends them again.

materialize rebuilds from the store, with the read key in <config>/agent-transcripts/read-key
(the owner's machine only), a folder in Claude Code's layout: projects/<repository>/<id>.jsonl
and <id>/subagents/<agent>.jsonl, each file's time set from its last timestamp, sessions/<id>.json
(the index entry), and skills/<plugin:skill>/SKILL.md from the blob each session recorded, read
from the git repository at --repo-dir (default the current directory). It checks every chunk
against its chain id and writes no session whose chain does not match.

redact applies the redaction to lines on stdin.

grade scores each session in DIR (a local archive, or a folder materialize wrote; default the
archive AGENT_TRANSCRIPTS names) against the change skill's steps with the field graders in
grade/fields.py: tier-declared, probe-before-record, record-before-code, red-first,
change-line, record-check and outcome-filled, each pass, fail or not_applicable with its
evidence. The record is read at the session's first and last commit from the git repository at
--repo-dir (default the current directory), and record-check runs on that range. It writes one
row per step to DIR/scores/<sessionId>.json and prints a summary. --store also inserts the rows
into the store's scores table at AGENT_TRANSCRIPTS_URL with the read key (the owner's machine
only). A session it cannot grade (a line that is not JSON, a commit the repository lacks) is
reported and the others are graded; the exit status is then 1. --transcript grades one
transcript file, with no index entry and no commit, and prints the rows as JSON lines.

sheet writes, for each session in DIR, DIR/sheets/<sessionId>.md: what the session did, call by
call, with the question each step asks and nothing a grader concluded, redacted. A person
labels from it. It also leaves a label file to fill in, <labels>/<sessionId>.txt (default the
plugin's grade/labels), holding the hash of the transcript; a label file a person has written
in is never overwritten. --transcript makes the sheets of transcript files (gzipped or not)
into --out, which like DIR is outside every working tree.

accuracy compares the field graders' latest score rows in DIR/scores with the label files
(grade/labels.py has the format) and prints, per step: sessions labelled, agreements, false
fails, false passes and false n/a, then each disagreement with its session id, then what was
not counted and why. A label whose transcript hash no longer matches is stale and is not
counted. --transcript grades the files as `grade --transcript` does and compares those rows.
It exits 1 when a label file is rejected (a missing step, an unknown verdict), 0 otherwise.

judge --repeats sends each chosen session's closing message, redacted, to Claude Sonnet, which
lists what the message says twice; the quotes are checked against the message and the share of
points said again is kept in DIR/repeats (grade/repeats.py). No call is made until the sessions
are chosen with --session or --limit.

judge --review runs, for each chosen session's own commits, a reviewer with a shell in a scratch
clone and in Claude Code's sandbox, and counts as shown only the defects whose scripts the tool
itself sees exit 0 at the session's last commit and not at its base, each run in a bwrap box
(grade/review.py). The answers are kept in DIR/reviews. No call is made until the sessions are
chosen with --session or --limit.

messages fills the store's readable table (store/schema.sql: `messages`, and the view `transcript`
the dashboard reads) from the chunks the store holds, with the read key: for each chunk it reads the
rows its redacted lines give, a row for each text, tool call and tool result, and inserts the ones
the table does not have. A chunk whose bytes do not match its id is named and left out; the chunk
store/probe leaves behind is passed over.
messages --check changes nothing: it prints each row that is missing, that is there and is not its
chunk's, that differs, or whose chunk the store does not hold, and exits 1 if there is one.

propose drafts an edit to the skill a session used, from one failure that a person's label confirms
(grade/propose.py): the session's label file must say `fail` for the step, by a named person, of this
version of the transcript, or nothing is sent and nothing written. One call to Claude Sonnet, with
what a label sheet shows, redacted. The proposed file, its diff and a page naming the eval case that
must show the edit helps go to DIR/proposals/<session>/<step>/; the skill itself is never written.

probe is a Codex or Cursor hook command that writes a sample of what the hook passed, holding
structure and no content, to DIR (default grade/fixtures/agents): see probe/agent_sample.py.
"""
import base64
import fnmatch
import glob
import gzip
import hashlib
import json
import os
import re
import secrets
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import zlib
from datetime import datetime, timedelta, timezone
from urllib.parse import quote, urlsplit

SCHEMA = 1
STALE_LOCK = 60  # seconds; the hooks time out after 10
HOME = os.path.expanduser("~")


class Busy(Exception):
    pass


def say(msg):
    print("transcripts: " + msg, file=sys.stderr)


def git(cwd, *args):
    if not cwd or not os.path.isdir(cwd):
        return None
    try:
        r = subprocess.run(["git", "-C", cwd] + list(args), capture_output=True, text=True, timeout=5,
                           env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def normalise_url(url):
    """host/owner/name, lower case, whatever the scheme, credentials, port or .git suffix."""
    if not url:
        return None
    url = url.strip()
    m = re.match(r"^(?:[^@/]+@)?([^:/]+):(?!//)(.+)$", url)  # scp-like: git@host:owner/name
    if m and "://" not in url:
        host, path = m.group(1), m.group(2)
    elif "://" in url:
        u = urlsplit(url)
        host, path = (u.hostname or ""), u.path
        if host in ("127.0.0.1", "localhost") and path.startswith("/git/"):
            host, path = "github.com", path[len("/git"):]  # the cloud's local git proxy
    else:
        return os.path.abspath(url).lower()
    path = path.strip("/")
    if path.endswith(".git"):
        path = path[:-4]
    return (host + "/" + path.strip("/")).lower()


def repository(cwd):
    return normalise_url(git(cwd, "remote", "get-url", "origin"))


def scope_file():
    return os.path.join(conf_dir(), "scope")


def scope_lines():
    """The owner's scope list as (line number, whether it excludes, the pattern as written); None when there is no list."""
    try:
        with open(scope_file(), encoding="utf-8", errors="replace") as f:
            text = f.read()
    except FileNotFoundError:
        return None
    out = []
    for n, line in enumerate(text.splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        excludes = line.startswith("!")
        pattern = line[1:].strip() if excludes else line
        if pattern:
            out.append((n, excludes, pattern))
    return out


def scope_of(cwd, lines=False):
    """(whether a session in the folder cwd is in scope, why, in words that follow "in scope: " or "not in scope: ").

    Nothing is in scope until a line of the owner's list names its repository, and a folder with no
    repository to name, or one that only a path on this machine names, never is. lines: the list as
    scope_lines gives it, when the caller has read it. A list that cannot be read raises OSError.
    """
    lines = scope_lines() if lines is False else lines
    listed = scope_file()
    if lines is None:
        return False, f"there is no scope list at {listed}"
    if not lines:
        return False, f"the scope list {listed} names no repository"
    if not git(cwd, "rev-parse", "--git-dir"):
        return False, f"{cwd} is in no git repository"
    repo = repository(cwd)
    if not repo:
        return False, f"the repository at {cwd} has no origin"
    if repo.startswith("/") or "/" not in repo:
        return False, f"the origin of the repository at {cwd} is a local path, {repo}"
    hits = [(n, excludes, pattern) for n, excludes, pattern in lines if fnmatch.fnmatchcase(repo, pattern.lower())]
    for n, excludes, pattern in hits:
        if excludes:
            return False, f"line {n} of {listed} excludes {repo}, !{pattern}"
    if not hits:
        return False, f"no line of {listed} matches {repo}"
    return True, f"line {hits[0][0]} of {listed}, {hits[0][2]}"


def session_in_scope(cwd, path):
    """Whether the session whose transcript is at path, now in cwd, may be archived: the folder it is in
    and the folder it began in must both be in scope, so a session that left a repository the list does
    not name for one it does is not kept."""
    lines = scope_lines()
    began = head_fields(path)[1]
    cwd = cwd or began or os.getcwd()
    return all(scope_of(d, lines)[0] for d in dict.fromkeys([cwd, began or cwd]))


def machine():
    if os.environ.get("CLAUDE_CODE_REMOTE") == "true":
        return {"id": None, "cloud_container": os.environ.get("CLAUDE_CODE_CONTAINER_ID") or None,
                "cloud_session": os.environ.get("CLAUDE_CODE_REMOTE_SESSION_ID") or None}
    d = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "agent-transcripts")
    p = os.path.join(d, "machine-id")
    mid = None
    try:
        with open(p) as f:
            mid = f.read().strip() or None
    except OSError:
        try:
            os.makedirs(d, exist_ok=True)
            fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(secrets.token_hex(16) + "\n")
        except FileExistsError:
            pass
        except OSError as e:
            say(f"cannot write the machine id at {p} ({e}); the entry has none")
        try:
            with open(p) as f:
                mid = f.read().strip() or None
        except OSError:
            pass
    return {"id": mid, "cloud_container": None, "cloud_session": None}


def is_eval(cwd):
    return bool(cwd) and "/claude-eval-" in cwd


def inside_work_tree(path):
    p = os.path.abspath(path)
    while True:
        if os.path.exists(os.path.join(p, ".git")):
            return p
        up = os.path.dirname(p)
        if up == p:
            return None
        p = up


def write_atomic(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def blob_hash(path):
    try:
        data = open(path, "rb").read()
    except OSError:
        return None
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def find_skill_file(name, root):
    plugin, _, skill = name.rpartition(":")
    cands = []
    if plugin:
        if root:
            cands.append(os.path.join(root, "plugins", plugin, "skills", skill, "SKILL.md"))
        found = [p for p in glob.glob(os.path.join(HOME, ".claude", "plugins", "**", "skills", skill, "SKILL.md"),
                                      recursive=True) if f"/{plugin}/" in p]
        cands += sorted(found, key=lambda p: -os.path.getmtime(p))
    else:
        if root:
            cands.append(os.path.join(root, ".claude", "skills", skill, "SKILL.md"))
        cands.append(os.path.join(HOME, ".claude", "skills", skill, "SKILL.md"))
    return next((c for c in cands if os.path.isfile(c)), None)


def show_path(path, root):
    if root and os.path.abspath(path).startswith(root.rstrip("/") + "/"):
        return os.path.relpath(path, root)
    return "~" + path[len(HOME):] if path.startswith(HOME + "/") else path


RECORD = re.compile(r"(?:^|/)(docs/changes/(?!README\.md$)[^/\s]+\.md)$")
CHANGE_LINE = re.compile(r"^Change: (docs/changes/[^/\s]+\.md)[ \t]*$", re.M)
SKILL_FILE = re.compile(r"(?:/plugins/([^/]+))?/skills/([^/]+)/SKILL\.md$")
# a shell command that prints a skill file: a session without the plugin installed reads it this way
BASH_READ_SKILL = re.compile(r"(?:^|[;&|(]\s*|\s)(?:cat|head|tail|sed|less|more|nl|bat)\b[^;&|]*?"
                             r"(?<![^\s'\"=])['\"]?([^\s'\";&|]*skills/[^/\s'\";&|]+/SKILL\.md)\b")


def scan(lines, entry, cwd, root):
    """Fold timestamps, skills and records from new transcript lines into the entry."""
    for raw in lines:
        try:
            d = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(d, dict):
            continue
        ts = d.get("timestamp")
        if isinstance(ts, str) and ts:
            if not entry["first_timestamp"] or ts < entry["first_timestamp"]:
                entry["first_timestamp"] = ts
            if not entry["last_timestamp"] or ts > entry["last_timestamp"]:
                entry["last_timestamp"] = ts
        if d.get("type") != "assistant":
            continue  # tool results and user text can quote anything; only the session's own acts count
        content = (d.get("message") or {}).get("content")
        for b in content if isinstance(content, list) else []:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text":
                for m in CHANGE_LINE.finditer(b.get("text") or ""):
                    add(entry["records"]["change_line"], m.group(1))
            if b.get("type") != "tool_use" or not isinstance(b.get("input"), dict):
                continue
            name, inp = b.get("name"), b["input"]
            fp = inp.get("file_path") or inp.get("notebook_path") or ""
            for used, how, full in skill_uses(name, inp, cwd):
                skill(entry, used, how, find_skill_file(used, root) if how == "Skill" else full, root)
            if name in ("Write", "Edit", "MultiEdit", "NotebookEdit") and RECORD.search(fp):
                add(entry["records"]["written"], RECORD.search(fp).group(1))


def skill_uses(name, inp, cwd):
    """[(skill, how, the file's path or None)] for one tool call: the skill called with the Skill
    tool, or its SKILL.md read with Read or printed by a shell command."""
    fp = inp.get("file_path") or inp.get("notebook_path") or ""
    if name == "Skill" and isinstance(inp.get("skill"), str):
        return [(inp["skill"], "Skill", None)]
    out = []
    if name == "Read" and SKILL_FILE.search(fp):
        m = SKILL_FILE.search(fp)
        full = fp if os.path.isabs(fp) else os.path.join(cwd or "", fp)
        out.append(((m.group(1) + ":" if m.group(1) else "") + m.group(2), "Read", full))
    elif name == "Bash" and isinstance(inp.get("command"), str):
        for p in BASH_READ_SKILL.findall(inp["command"]):
            full = p if os.path.isabs(p) else os.path.join(cwd or "", p)
            m = SKILL_FILE.search(full)
            if m:
                out.append(((m.group(1) + ":" if m.group(1) else "") + m.group(2), "Bash", full))
    return out


def skills_in(lines):
    """The names of the skills a transcript shows used, by the rule the capture hook applies, in order."""
    names = []
    for raw in lines:
        try:
            d = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(d, dict) or d.get("type") != "assistant" or d.get("isSidechain"):
            continue
        content = (d.get("message") or {}).get("content")
        for b in content if isinstance(content, list) else []:
            if isinstance(b, dict) and b.get("type") == "tool_use" and isinstance(b.get("input"), dict):
                for used, _, _ in skill_uses(b.get("name"), b["input"], d.get("cwd")):
                    add(names, used)
    return names


def add(lst, v):
    if v not in lst:
        lst.append(v)


def skill(entry, name, how, path, root):
    if any(s["name"] == name for s in entry["skills"]):
        return
    found = path if path and os.path.isfile(path) else None
    entry["skills"].append({"name": name, "how": how, "file": show_path(found, root) if found else None,
                            "blob": blob_hash(found) if found else None})


def choose_record(r):
    both = [x for x in r["written"] if x in r["change_line"]]
    if len(both) == 1:
        return both[0]
    if both or (r["written"] and r["change_line"]):
        return None  # they disagree, or name several: better no record than the wrong one
    one = r["written"] or r["change_line"]
    return one[0] if len(one) == 1 else None


def head_fields(path):
    sid = cwd = branch = None
    entrypoint = None
    try:
        with open(path, "rb") as f:
            for i, raw in enumerate(f):
                if i > 200 or (sid and cwd):
                    break
                try:
                    d = json.loads(raw)
                except ValueError:
                    continue
                if isinstance(d, dict):
                    sid = sid or d.get("sessionId")
                    cwd = cwd or d.get("cwd")
                    branch = branch or d.get("gitBranch")
                    entrypoint = entrypoint or d.get("entrypoint")
    except OSError:
        pass
    return sid, cwd, branch, entrypoint


def last_branch(data):
    for raw in reversed(data.splitlines()[-200:]):
        m = re.search(rb'"gitBranch":"([^"]*)"', raw)
        if m:
            return m.group(1).decode("utf-8", "replace")
    return None


class Lock:
    def __init__(self, path):
        self.path = path

    def __enter__(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        try:
            os.mkdir(self.path)
        except FileExistsError:
            try:
                if time.time() - os.path.getmtime(self.path) < STALE_LOCK:
                    raise Busy(f"another run is archiving this session ({self.path})")
                os.rmdir(self.path)
                os.mkdir(self.path)
            except FileNotFoundError:
                os.mkdir(self.path)
        return self

    def __exit__(self, *a):
        try:
            os.rmdir(self.path)
        except OSError:
            pass


def archive_session(ar, path, hook_cwd=None, imported=False):
    """Archive one transcript and its subagents; returns the number of new parts written."""
    if not os.path.isfile(path):
        raise FileNotFoundError(f"no transcript at {path}")
    sid, line_cwd, first_branch, entrypoint = head_fields(path)
    sid = sid or os.path.basename(path)[:-len(".jsonl")]
    if not re.match(r"^[A-Za-z0-9._-]+$", sid) or sid.startswith("."):
        raise ValueError(f"session id {sid!r} in {path} is not a plain name")
    cwd = hook_cwd or line_cwd or os.getcwd()
    root = git(cwd, "rev-parse", "--show-toplevel")
    with Lock(os.path.join(ar, "locks", sid)):
        ep = os.path.join(ar, "sessions", sid + ".json")
        try:
            entry = json.load(open(ep))
        except FileNotFoundError:
            entry = None
        if entry is None:
            parent = None if imported else (os.environ.get("AGENT_TRANSCRIPTS_PARENT") or None)
            if parent == sid:
                parent = None
            m = machine()
            cloud = os.environ.get("CLAUDE_CODE_REMOTE") == "true" or entrypoint == "remote"
            entry = {
                "schema": SCHEMA, "session_id": sid,
                "source": "eval" if is_eval(cwd) else "dispatch" if parent else "cloud" if cloud else "local",
                "machine": m, "repository": None, "first_stop": None, "last_stop": None,
                "first_timestamp": None, "last_timestamp": None, "skills": [],
                "records": {"written": [], "change_line": []}, "record": None,
                "parent_session": parent, "streams": {}, "sent": {}, "redaction_version": None,
            }
        entry["repository"] = entry["repository"] or repository(cwd)

        streams = [("main", path)]
        sub = os.path.join(path[:-len(".jsonl")], "subagents")
        for p in sorted(glob.glob(os.path.join(sub, "**", "agent-*.jsonl"), recursive=True)):
            streams.append(("subagents/" + os.path.relpath(p, sub)[:-len(".jsonl")], p))
        new_parts = 0
        main_data = b""
        for name, p in streams:
            data = open(p, "rb").read()
            if name == "main":
                main_data = data
            cut = data[:data.rfind(b"\n") + 1]  # a line still being written waits for the next stop
            st = entry["streams"].get(name) or {"generation": 1, "parts": 0, "lines": 0, "bytes": 0,
                                                "sha256": hashlib.sha256(b"").hexdigest()}
            if len(cut) < st["bytes"] or hashlib.sha256(cut[:st["bytes"]]).hexdigest() != st["sha256"]:
                say(f"{p} is not an extension of what was archived; archiving it whole as generation {st['generation'] + 1}")
                st = {"generation": st["generation"] + 1, "parts": 0, "lines": 0, "bytes": 0,
                      "sha256": hashlib.sha256(b"").hexdigest()}
            new = cut[st["bytes"]:]
            if new:
                n = st["parts"] + 1
                write_atomic(os.path.join(ar, "parts", sid, name, "g%d-%06d.jsonl" % (st["generation"], n)), new)
                lines = new.splitlines()
                scan(lines, entry, cwd, root)
                st.update(parts=n, lines=st["lines"] + len(lines), bytes=len(cut), sha256=hashlib.sha256(cut).hexdigest())
                new_parts += 1
            entry["streams"][name] = st
        if imported:
            stop = {"branch": last_branch(main_data) or first_branch, "commit": None}
            first = {"branch": first_branch, "commit": None}
        else:
            stop = {"branch": git(cwd, "rev-parse", "--abbrev-ref", "HEAD"), "commit": git(cwd, "rev-parse", "HEAD")}
            first = stop
        entry["first_stop"] = entry["first_stop"] or first
        entry["last_stop"] = stop
        entry["record"] = choose_record(entry["records"])
        write_atomic(ep, (json.dumps(entry, indent=2) + "\n").encode())
    return new_parts


def archive_dir():
    ar = os.environ.get("AGENT_TRANSCRIPTS") or ""
    if not ar:
        return None
    ar = os.path.abspath(os.path.expanduser(ar))
    tree = inside_work_tree(ar)
    if tree:
        raise PermissionError(f"AGENT_TRANSCRIPTS={ar} is inside the working tree of {tree}; "
                              "put the archive outside any repository so transcripts are never committed")
    return ar


def cmd_archive(args):
    transcript, scoped, i = None, False, 0
    while i < len(args):
        if args[i] == "--scoped" and not scoped:
            scoped, i = True, i + 1
        elif args[i] == "--transcript" and transcript is None and i + 1 < len(args):
            transcript, i = args[i + 1], i + 2
        else:
            say("usage: transcripts archive [--scoped] [--transcript PATH]")
            return 0
    try:
        ar = archive_dir()
        if ar is None:
            return 0
        cwd = hook = None
        if transcript is None:
            raw = sys.stdin.read()
            try:
                hook = json.loads(raw)
                transcript, cwd = hook["transcript_path"], hook.get("cwd")
            except (ValueError, KeyError, TypeError) as e:
                say(f"the hook input is not JSON with a transcript_path ({e}); nothing archived")
                return 0
        transcript = os.path.abspath(os.path.expanduser(transcript))
        if scoped:
            try:
                if not session_in_scope(cwd, transcript):
                    return 0  # not the owner's to keep: nothing archived, nothing sent, nothing said
            except OSError as e:
                say(f"the scope list cannot be read ({e}); nothing archived")
                return 0
        try:
            archive_session(ar, transcript, cwd)
        finally:
            if hook is not None and os.environ.get("AGENT_TRANSCRIPTS_URL"):
                start_background_push(ar)
    except Busy as e:
        say(f"{e}; the lines are kept for the next stop")
    except Exception as e:  # never fail the session
        say(f"{e}; nothing archived this time, the lines are kept for the next stop")
    return 0


def cmd_import(args):
    home, repos, evals, scoped = os.path.join(HOME, ".claude"), [], False, False
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--claude-home", "--repo") and i + 1 < len(args):
            if a == "--claude-home":
                home = args[i + 1]
            else:
                repos.append(normalise_url(args[i + 1]))
            i += 2
        elif a == "--evals":
            evals, i = True, i + 1
        elif a == "--scoped":
            scoped, i = True, i + 1
        else:
            i = len(args) + 1
    if i > len(args) or (scoped and (repos or evals)):  # with --scoped the list alone says what is taken
        say("usage: transcripts import [--claude-home DIR] [--repo URL]... [--evals]\n"
            "       transcripts import [--claude-home DIR] --scoped")
        return 2
    try:
        ar = archive_dir()
    except PermissionError as e:
        say(str(e))
        return 2
    if ar is None:
        say("AGENT_TRANSCRIPTS is not set; set it to the archive directory to import into")
        return 2
    listed, known = None, {}
    if scoped:
        try:
            listed = scope_lines()
        except OSError as e:
            say(f"cannot read the scope list ({e})")
            return 2

    def taken(cwd):
        if not scoped:
            return (evals and is_eval(cwd)) or (not is_eval(cwd) and repository(cwd) in repos)
        if cwd not in known:
            known[cwd] = scope_of(cwd, listed)[0]
        return known[cwd]
    if not repos and not scoped:
        here = repository(os.getcwd())
        if not here:
            say("the current directory has no origin remote; run import in a checkout or pass --repo URL")
            return 2
        repos = [here]
    imported = unchanged = skipped = failed = 0
    for path in sorted(glob.glob(os.path.join(home, "projects", "*", "*.jsonl"))):
        _, cwd, _, _ = head_fields(path)
        if not taken(cwd):
            skipped += 1
            continue
        try:
            if archive_session(ar, path, cwd, imported=True):
                imported += 1
            else:
                unchanged += 1
        except Exception as e:
            say(f"{path}: {e}")
            failed += 1
    print(f"transcripts: imported {imported}, unchanged {unchanged}, skipped {skipped} (not in scope)"
          + (f", failed {failed}" if failed else "") + f"; archive {ar}")
    return 1 if failed else 0


def megabytes(n):
    return "%.1f MB" % (n / 1e6)


def cmd_scope(args):
    if len(args) > 1 or (args and not os.path.isdir(args[0])):
        say("usage: transcripts scope [DIR]   (DIR: a folder, default the current one)")
        return 2
    d = os.path.abspath(args[0]) if args else os.getcwd()
    try:
        ok, why = scope_of(d)
    except OSError as e:
        ok, why = False, f"the scope list cannot be read ({e})"
    print(f"{repository(d)} is in scope: {why}" if ok else f"not in scope: {why}")
    try:
        ar = archive_dir()
        if ar is None:
            print("AGENT_TRANSCRIPTS is not set: no session is archived on this machine, in scope or not")
        else:
            size = 0
            for root, _, files in os.walk(os.path.join(ar, "parts")):
                size += sum(os.path.getsize(os.path.join(root, f)) for f in files)
            n = len(glob.glob(os.path.join(ar, "sessions", "*.json")))
            print(f"the archive {ar} holds {n} session{'s' if n != 1 else ''}, {megabytes(size)} of transcripts, not redacted")
    except (PermissionError, OSError) as e:
        print(f"the archive cannot be read: {e}")
    return 0 if ok else 1


# ---- the store: redaction, push, materialize ----

REDACTION = 2  # bump when the patterns change: every stream is then sent again as a new generation
CHUNK_BYTES = 2_000_000  # redacted bytes per chunk before gzip; the real project took a 4 MB body
SHAPE = 1  # the version of the rule that reads a chunk's rows for `messages`; store/schema.sql's view names the same
PUSH_LIMIT = 60  # seconds a background push may run

_R = lambda p, f=0: re.compile(p, f)  # noqa: E731
PATTERNS = [  # (pattern, replacement), in order; applied to every decoded JSON string
    (_R(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(?:-----END [A-Z ]*PRIVATE KEY-----|$)", re.S), "<redacted:private-key>"),
    (_R(r"(://[^/\s:@]+:)[^/\s@]+@"), r"\1<redacted:password>@"),
    (_R(r"\bsk-ant-[A-Za-z0-9_-]{10,}"), "<redacted:anthropic-key>"),
    (_R(r"\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})"), "<redacted:github-token>"),
    (_R(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b"), "<redacted:aws-key>"),
    (_R(r"(?i)(aws_secret_access_key\W{0,3}\s*[=:]\s*\W?)[A-Za-z0-9/+=]{40}"), r"\1<redacted:aws-secret>"),
    (_R(r"\bsb_(?:secret|publishable)_[A-Za-z0-9_-]{10,}"), "<redacted:supabase-key>"),
    (_R(r"\bxox[abposr]-[A-Za-z0-9-]{10,}"), "<redacted:slack-token>"),
    (_R(r"\bsk-[A-Za-z0-9_-]{20,}"), "<redacted:api-key>"),
    (_R(r"\beyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}"), "<redacted:jwt>"),
    (_R(r"(?i)\b(bearer|token|basic)(\s+)[A-Za-z0-9._~+/=-]{8,}"), r"\1\2<redacted:token>"),
]
# An address is [A-Za-z0-9._%+-]+ (?:@|%40) [A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}. As one pattern it is
# tried from every position of a long run of those characters that no @ follows, which takes a time that
# grows with the square of the run; redact_emails gives what that pattern gives, in one pass.
EMAIL_LOCAL = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._%+-")
EMAIL_SEP = _R(r"@|%40")
EMAIL_RUN = _R(r"[A-Za-z0-9._%+-]*")
EMAIL_DOMAIN = _R(r"[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}")


def redact_emails(t):
    out, pos, tried = [], 0, 0  # pos: the end of the last address; tried: no address begins before here
    for m in EMAIL_SEP.finditer(t):
        j = m.start()
        if j < tried:
            continue
        s = j  # the run of local-part characters this separator ends or lies in, from where the last address ended
        while s > pos and t[s - 1] in EMAIL_LOCAL:
            s -= 1
        e = j if t[j] == "@" else EMAIL_RUN.match(t, j).end()
        end = None
        if e > s and t[e:e + 1] == "@":  # the longest local part first, as the pattern's greedy + has it
            d = EMAIL_DOMAIN.match(t, e + 1)
            end = d.end() if d else None
        k = t.rfind("%40", s + 1, e)  # then each %40 inside the run, the last first
        while end is None and k != -1:
            d = EMAIL_DOMAIN.match(t, k + 3)
            end = d.end() if d else None
            k = t.rfind("%40", s + 1, k)
        if end is None:
            tried = e + 1 if t[e:e + 1] == "@" else e
        else:
            out += [t[pos:s], "<redacted:email>"]
            pos = tried = end
    return "".join(out) + t[pos:] if out else t


# The ids of the owner's account. A harness writes them under these keys; the same value then turns
# up in text no pattern can know (a folder name, a URL), so a value seen under a key is learned and
# taken out of every string after that. Learn before redacting: learn_ids on the lines first.
ACCOUNT_KEYS = ("organizationUuid", "accountUuid", "userID", "organization_uuid", "account_uuid")
ACCOUNT_MARK = "<redacted:account-id>"
# on raw bytes, so the key inside a string that is itself JSON (its quotes escaped) counts too
ACCOUNT_ID = re.compile(rb'\\*"(?:' + "|".join(ACCOUNT_KEYS).encode() + rb')\\*"\s*:\s*\\*"([A-Za-z0-9_-]{8,})\\*"')
# a harness names a folder <organization id>_<account id>: a UUID joined so to a known id is one too
JOINED_ID = rb"_([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"
KNOWN_IDS = set()


def learn_ids(data):
    """Remember the account ids named in these raw lines (bytes, or a list of lines)."""
    if not isinstance(data, (bytes, bytearray)):
        data = b"\n".join(data)
    KNOWN_IDS.update(m.decode() for m in ACCOUNT_ID.findall(data))
    for known in sorted(KNOWN_IDS):
        KNOWN_IDS.update(m.decode() for m in re.findall(re.escape(known.encode()) + JOINED_ID, data))


def redact_text(t):
    for pat, rep in PATTERNS:
        t = pat.sub(rep, t)
    for known in sorted(KNOWN_IDS, key=len, reverse=True):  # the longest first: one id may begin another
        t = t.replace(known, ACCOUNT_MARK)
    return redact_emails(t)


def redact_obj(o):
    if isinstance(o, str):
        return redact_text(o)
    if isinstance(o, list):
        return [redact_obj(x) for x in o]
    if isinstance(o, dict):
        return {redact_text(k): ACCOUNT_MARK if k in ACCOUNT_KEYS and isinstance(v, str) else redact_obj(v)
                for k, v in o.items()}
    return o


def redact_line(raw):
    """One transcript line, redacted. Strings are redacted after JSON decoding, so an escape
    such as \\n can never be cut in half; a line with nothing to redact keeps its exact bytes."""
    end = b"\n" if raw.endswith(b"\n") else b""
    body = raw[:-1] if end else raw
    try:
        obj = json.loads(body)
    except ValueError:
        return redact_text(body.decode("utf-8", "replace")).encode() + end
    new = redact_obj(obj)
    if new == obj:
        return raw
    try:
        return json.dumps(new, ensure_ascii=False, separators=(",", ":")).encode() + end
    except UnicodeEncodeError:  # a lone surrogate: escape it rather than write bad UTF-8
        return json.dumps(new, separators=(",", ":")).encode() + end


def conf_dir():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "agent-transcripts")


def key_file(name, required):
    p = os.path.join(conf_dir(), name)
    try:
        st = os.stat(p)
    except FileNotFoundError:
        if required:
            raise StoreError(f"the store's read key is needed in {p} (mode 0600), on the owner's machine only")
        return None
    if st.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        raise StoreError(f"{p} can be read by other users; chmod 600 it")
    return open(p).read().strip() or None


class StoreError(Exception):
    """status: the store's answer when it refused rows, None for every other failure."""

    def __init__(self, msg, status=None):
        super().__init__(msg)
        self.status = status


class TimeLimit(Exception):
    pass


def store_url():
    url = (os.environ.get("AGENT_TRANSCRIPTS_URL") or "").rstrip("/")
    if not url:
        return None
    u = urlsplit(url)
    if u.scheme != "https" and not (u.scheme == "http" and u.hostname in ("127.0.0.1", "localhost")):
        raise StoreError(f"AGENT_TRANSCRIPTS_URL={url} is not https; transcripts are only sent encrypted")
    return url


def request(url, key, method, path, body=None):
    req = urllib.request.Request(url + path, method=method,
                                 data=None if body is None else json.dumps(body, separators=(",", ":")).encode())
    req.add_header("Content-Type", "application/json")
    req.add_header("Prefer", "return=minimal")
    if key:
        req.add_header("apikey", key)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()
    except (urllib.error.URLError, OSError) as e:
        raise StoreError(f"cannot reach {url} ({getattr(e, 'reason', e)})")


def insert(url, key, table, row):
    status, body = request(url, key, "POST", "/rest/v1/" + table, row)
    if status in (200, 201, 204) or (status == 409 and b"23505" in body):
        return status != 409  # a 409 duplicate is a row the store already has
    raise StoreError(f"{table} insert answered {status}: {body[:200].decode('utf-8', 'replace')}", status)


def sender_id():
    m = machine()
    if m["cloud_container"]:
        return "cloud:" + m["cloud_container"]
    return m["id"] or "unknown"


def chain_root(sid, stream):
    return hashlib.sha256(f"{sid}/{stream}".encode()).hexdigest()


def chunk_id(start, raw):
    return hashlib.sha256(f"{start}:{hashlib.sha256(raw).hexdigest()}".encode()).hexdigest()


def update_sent(ar, sid, sent):
    """Write the sent state into the session's index entry, under the archive's session lock."""
    for _ in range(50):
        try:
            with Lock(os.path.join(ar, "locks", sid)):
                ep = os.path.join(ar, "sessions", sid + ".json")
                entry = json.load(open(ep))
                entry["sent"] = sent
                entry["redaction_version"] = sent["redaction"]
                write_atomic(ep, (json.dumps(entry, indent=2) + "\n").encode())
                return entry
        except Busy:
            time.sleep(0.1)
    raise Busy(f"the archive kept {sid} locked; its sent state is written at the next push")


def part_pieces(data):
    """A part's redacted lines cut into chunks: whole lines, CHUNK_BYTES at most unless one line is more."""
    pieces, cur = [], b""
    for x in data.splitlines(keepends=True):
        if cur and len(cur) + len(x) > CHUNK_BYTES:
            pieces.append(cur)
            cur = b""
        cur += x
    return pieces + ([cur] if cur else [])


def chunk_requests(sid, stream, cid, raw):
    """The requests of rows for one chunk, the same whoever sends them: `push` after the chunk, and
    `transcripts messages` for what the store holds."""
    return row_requests([dict({"session_id": sid, "stream": stream, "chunk_id": cid}, **r) for r in message_rows(raw)])


def push_session(ar, url, key, sid, sender, no_table=None, retry=True):
    """Send one session's unsent parts with each chunk's rows, the requests of rows it owes from before,
    and, if it changed, its index entry; returns (chunks, index rows, requests of rows still owed).
    Rows never hold back a chunk, a part or the index row: a request of rows that is refused or gets
    no answer is kept in the sent state as owed, and sent again by the next push."""
    entry = json.load(open(os.path.join(ar, "sessions", sid + ".json")))
    sent = json.loads(json.dumps(entry.get("sent") or {}))
    sent.setdefault("streams", {})
    owed = [o for o in sent.get("owed") or [] if o.get("stream") in entry["streams"]]
    # no_table: the caller's list for the run; it holds the store's answer once the store has said it has no
    # such table, and from then on no more rows go to it, for this session or the next
    no_table = [] if no_table is None else no_table

    def restart(name, st):
        s = sent["streams"].get(name)
        sent["streams"][name] = {"archive_generation": st["generation"], "parts": 0, "generation": (s["generation"] + 1 if s else 1),
                                 "chunks": 0, "lines": 0, "bytes": 0, "tip": chain_root(sid, name)}
        owed[:] = [o for o in owed if o["stream"] != name]  # its parts are all sent again, rows and all
        return sent["streams"][name]

    def save():
        sent["owed"] = list(owed)
        if not owed:
            del sent["owed"]
        update_sent(ar, sid, sent)

    def redacted(name, st, n):
        data = open(os.path.join(ar, "parts", sid, name, "g%d-%06d.jsonl" % (st["generation"], n)), "rb").read()
        learn_ids(data)
        return b"".join(redact_line(x) for x in data.splitlines(keepends=True))

    def send_rows(req, unstored):
        """One request of rows: True when it is there afterwards, False when it is owed. `unstored`: this
        sender knows it has not stored the request (a chunk it has just stored, or a request it owes), so a
        refusal as a duplicate means another hand wrote some of it, and its rows go one at a time."""
        if no_table:
            return False
        try:
            if not insert(url, key, "messages", req) and unstored:
                for r in req:
                    insert(url, key, "messages", [r])  # a duplicate here is a row that is there
            return True
        except StoreError as e:
            if e.status == 404:
                no_table.append(e)
            return False

    if sent.get("redaction") != REDACTION:
        # a new redaction version (or a first push): every stream is owed. All of them restart before
        # anything is sent, so the state saved after the first part already says so, should the push stop there.
        for name, st in entry["streams"].items():
            restart(name, st)
    sent["redaction"] = REDACTION
    chunks = 0
    for name, st in entry["streams"].items():  # the key's line is among a stream's first; a later part has none
        try:
            learn_ids(open(os.path.join(ar, "parts", sid, name, "g%d-%06d.jsonl" % (st["generation"], 1)), "rb").read())
        except OSError:
            pass
    for name, st in sorted(entry["streams"].items()):
        s = sent["streams"].get(name)
        if s is None or s["archive_generation"] != st["generation"]:
            s = restart(name, st)
        cut = {}  # the pieces of each part that owes, cut from the archive as they first were
        for o in [o for o in owed if retry and o["stream"] == name]:  # retry: not for a session already sent in this run
            if o["part"] not in cut:
                try:
                    cut[o["part"]] = part_pieces(redacted(name, st, o["part"]))
                except OSError:  # the part is not in the archive any more
                    cut[o["part"]] = []
            raw = cut[o["part"]][o["chunk"]] if o["chunk"] < len(cut[o["part"]]) else None
            reqs = chunk_requests(sid, name, o["chunk_id"], raw) if raw is not None and chunk_id(o["start_id"], raw) == o["chunk_id"] else []
            if o["request"] >= len(reqs):
                say(f"{sid} {name}: chunk {o['chunk_id'][:12]} is not what the archive gives now; its rows are left to transcripts messages")
                owed.remove(o)
            elif send_rows(reqs[o["request"]], True):
                owed.remove(o)
        for n in range(s["parts"] + 1, st["parts"] + 1):
            for k, raw in enumerate(part_pieces(redacted(name, st, n))):
                start, cid = s["tip"], chunk_id(s["tip"], raw)
                new = insert(url, key, "chunks", {
                    "session_id": sid, "stream": name, "chunk_id": cid, "start_id": start, "sender": sender,
                    "generation": s["generation"], "number": s["chunks"] + 1, "lines": raw.count(b"\n"),
                    "bytes": len(raw), "redaction": REDACTION,
                    "data": base64.b64encode(gzip.compress(raw, mtime=0)).decode()})
                chunks += new
                s.update(tip=cid, chunks=s["chunks"] + 1, lines=s["lines"] + raw.count(b"\n"), bytes=s["bytes"] + len(raw))
                for i, req in enumerate(chunk_requests(sid, name, cid, raw)):  # every request, whether or not the chunk was new
                    if not send_rows(req, new):
                        owed.append({"stream": name, "part": n, "chunk": k, "request": i, "chunk_id": cid, "start_id": start})
            s["parts"] = n
            sent["row_pending"] = True  # the index row must follow, even if the push stops here
            save()  # each whole part, so a stopped push resumes after it
    if sent.get("version") and not sent.get("row_pending"):
        save()  # it was called for what it owed: what was struck off is written down
        return chunks, 0, len(owed)
    row_entry = dict(entry, sent={"redaction": REDACTION, "streams": sent["streams"]}, redaction_version=REDACTION)
    row_entry = redact_obj(row_entry)
    version = sent.get("version", 0) + 1
    row_entry["sent"]["version"] = version
    row_id = hashlib.sha256(json.dumps([sender, row_entry], sort_keys=True).encode()).hexdigest()
    insert(url, key, "sessions", {"session_id": sid, "row_id": row_id, "sender": sender, "version": version,
                                  "entry": row_entry})
    sent.update(version=version, row_pending=False)
    save()
    return chunks, 1, len(owed)


def unsent(ar, sid, rows=True):
    """Whether a session has anything to send. `rows`: requests of rows it owes count too."""
    try:
        e = json.load(open(os.path.join(ar, "sessions", sid + ".json")))
    except (OSError, ValueError):
        return False
    s = e.get("sent") or {}
    if s.get("redaction") != REDACTION or not s.get("version") or s.get("row_pending") or (rows and s.get("owed")):
        return True
    for name, st in e.get("streams", {}).items():
        x = s.get("streams", {}).get(name)
        if not x or x["archive_generation"] != st["generation"] or x["parts"] != st["parts"]:
            return True
    return False  # an index change without new lines goes with the next lines


def _time_limit(*a):
    raise TimeLimit("the push reached its time limit")


def cmd_push(args):
    background, only, i = False, [], 0
    while i < len(args):
        if args[i] == "--background":
            background, i = True, i + 1
        elif args[i] == "--session" and i + 1 < len(args):
            only.append(args[i + 1])
            i += 2
        else:
            say("usage: transcripts push [--session ID]... [--background]")
            return 2
    tell = (lambda m: say(time.strftime("%Y-%m-%dT%H:%M:%S ") + m)) if background else say
    try:
        ar = archive_dir()
        url = store_url()
    except (PermissionError, StoreError) as e:
        tell(str(e))
        return 0 if background else 2
    if ar is None or url is None:
        tell("push needs AGENT_TRANSCRIPTS (the archive) and AGENT_TRANSCRIPTS_URL (the store) set")
        return 0 if background else 2
    if background:
        try:
            limit = int(os.environ.get("AGENT_TRANSCRIPTS_PUSH_LIMIT") or PUSH_LIMIT)
        except ValueError:
            limit = PUSH_LIMIT
        signal.signal(signal.SIGALRM, _time_limit)
        signal.alarm(max(1, limit))
    chunks = rows = sessions = 0
    owed = {}  # by session: the requests of rows each still owes after this push
    no_table = []  # for the whole run: see push_session
    tried = set()  # the sessions whose owed rows this run has tried: once a run, however often a session is sent in it
    passed_over = {}  # sessions whose own data could not be sent: the others still go, and these are tried again next time
    try:
        key = key_file("insert-key", required=False)
        sender = sender_id()
        with Lock(os.path.join(ar, "locks", "push")):
            for again in range(3):  # lines archived while this push ran go in the next pass
                todo = [os.path.basename(p)[:-5] for p in sorted(glob.glob(os.path.join(ar, "sessions", "*.json")))]
                # what a session owes in rows is tried once a run: the store that refused them a moment ago would again
                todo = [x for x in todo if (not only or x in only) and x not in passed_over and unsent(ar, x, rows=not again)]
                if not todo:
                    break
                for sid in todo:
                    try:
                        first = sid not in tried
                        tried.add(sid)
                        c, r, owed[sid] = push_session(ar, url, key, sid, sender, no_table, retry=first)
                    except (OSError, ValueError, KeyError) as e:  # its archived files cannot be read
                        passed_over[sid] = e
                        continue
                    except StoreError as e:
                        if not its_own(e.status):
                            raise
                        passed_over[sid] = e
                        continue
                    chunks, rows, sessions = chunks + c, rows + r, sessions + 1
    except (StoreError, Busy, TimeLimit, OSError, ValueError, KeyError) as e:
        tell(f"push stopped: {e}; what was not sent goes at the next stop (sent {chunks} chunks before)")
        return 0 if background else 1
    finally:
        if background:
            signal.alarm(0)
    for sid, e in sorted(passed_over.items()):
        tell(f"{sid[:8]} ({sid}) could not be sent: {e}")
    owe = sum(owed.values())
    tell(f"pushed {chunks} new chunks and {rows} index rows for {sessions} sessions to {url}"
         + (f"; {so_many(owe, 'request')} of rows {'is' if owe == 1 else 'are'} owed and will be sent again at the next push" if owe else "")
         + (f"; {len(passed_over)} session{'s' if len(passed_over) > 1 else ''} could not be sent and will be tried again at the next push"
            if passed_over else ""))
    return 1 if passed_over and not background else 0


def its_own(status):
    """Whether a store's refusal is about the rows of one session: a 4xx that is not about who asks or how often."""
    return status is not None and 400 <= status < 500 and status not in (401, 403, 408, 429)


def start_background_push(ar):
    """Start `push --background` detached from the hook: its own session, no pipes to the hook."""
    try:
        log = os.path.join(ar, "push.log")
        if os.path.isfile(log) and os.path.getsize(log) > 1_000_000:
            os.replace(log, log + ".1")
        with open(log, "ab") as f:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "push", "--background"],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=f,
                             start_new_session=True, close_fds=True)
    except OSError as e:
        say(f"cannot start the background push ({e}); the lines go at the next stop")


def read_rows(url, key, path):
    rows, off = [], 0
    while True:
        status, body = request(url, key, "GET", f"{path}&limit=200&offset={off}")
        if status != 200:
            raise StoreError(f"GET {path} answered {status}: {body[:200].decode('utf-8', 'replace')}")
        page = json.loads(body)
        rows += page
        if len(page) < 200:
            return rows
        off += 200


def last_ts(data):
    best = None
    for raw in data.splitlines():
        m = re.search(rb'"timestamp":"([^"]+)"', raw)
        if m and (best is None or m.group(1) > best):
            best = m.group(1)
    if not best:
        return None
    try:
        return datetime.fromisoformat(best.decode().replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


# no segment may be `.` or `..`, the first after `subagents/` included; no skill part may start with a dot
STREAM = re.compile(r"^(?:main|subagents/(?!(?:.*/)?\.\.?(?:/|$))[A-Za-z0-9._/-]+)$")
SKILL_NAME = re.compile(r"^(?!\.)[A-Za-z0-9._-]+(?::(?!\.)[A-Za-z0-9._-]+)?$")


def git_blob(repo_dir, blob):
    try:
        r = subprocess.run(["git", "-C", repo_dir, "cat-file", "blob", blob], capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def cmd_materialize(args):
    out, only, repo_dir, i = None, [], os.getcwd(), 0
    while i < len(args):
        if args[i] in ("--session", "--repo-dir") and i + 1 < len(args):
            if args[i] == "--session":
                only.append(args[i + 1])
            else:
                repo_dir = args[i + 1]
            i += 2
        elif out is None and not args[i].startswith("--"):
            out, i = os.path.abspath(args[i]), i + 1
        else:
            out = None
            break
    if out is None:
        say("usage: transcripts materialize DIR [--session ID]... [--repo-dir DIR]")
        return 2
    tree = inside_work_tree(out)
    if tree:
        say(f"{out} is inside the working tree of {tree}; materialize outside any repository")
        return 2
    try:
        url = store_url()
        if url is None:
            raise StoreError("materialize needs AGENT_TRANSCRIPTS_URL, the store's URL")
        key = key_file("read-key", required=True)
    except StoreError as e:
        say(str(e))
        return 2
    failed = done = 0
    try:
        q = "/rest/v1/sessions?select=session_id,sender,version,entry&order=session_id,row_id"
        if only:
            q += "&session_id=in.(" + ",".join(quote(x, safe="") for x in only) + ")"
        best = {}
        for r in read_rows(url, key, q):
            e = r.get("entry") or {}
            # the newest redaction first: an older copy is longer where the newer redaction took something out
            rank = (e.get("redaction_version") or 0, e.get("last_timestamp") or "",
                    sum(s.get("bytes", 0) for s in (e.get("sent") or {}).get("streams", {}).values()), r.get("version") or 0)
            if r["session_id"] not in best or rank > best[r["session_id"]][0]:
                best[r["session_id"]] = (rank, e)
        skills = {}
        for sid, (_, e) in sorted(best.items()):
            try:
                if not re.match(r"^[A-Za-z0-9._-]+$", sid) or sid.startswith("."):
                    raise StoreError(f"session id {sid!r} is not a plain name")
                proj = re.sub(r"[^A-Za-z0-9]", "-", e.get("repository") or "unknown")
                files = []
                for name, s in sorted((e.get("sent") or {}).get("streams", {}).items()):
                    if not STREAM.match(name):
                        raise StoreError(f"stream {name!r} is not a transcript name")
                    rows = read_rows(url, key, f"/rest/v1/chunks?select=chunk_id,start_id,data&session_id=eq.{quote(sid, safe='')}"
                                     f"&stream=eq.{quote(name, safe='')}&order=chunk_id")
                    have = {r["chunk_id"]: r for r in rows}
                    cur, root, pieces = s["tip"], chain_root(sid, name), []
                    while cur != root:
                        r = have.get(cur)
                        if r is None or len(pieces) > len(have):
                            raise StoreError(f"{sid} {name}: chunk {cur[:12]} is missing")
                        raw = gzip.decompress(base64.b64decode(r["data"]))
                        if chunk_id(r["start_id"], raw) != cur:
                            raise StoreError(f"{sid} {name}: chunk {cur[:12]} does not match its chain id")
                        pieces.append(raw)
                        cur = r["start_id"]
                    data = b"".join(reversed(pieces))
                    rel = f"{sid}.jsonl" if name == "main" else f"{sid}/{name}.jsonl"
                    files.append((os.path.join(out, "projects", proj, rel), data))
                for p, data in files:
                    write_atomic(p, data)
                    t = last_ts(data)
                    if t:
                        os.utime(p, (t, t))
                write_atomic(os.path.join(out, "sessions", sid + ".json"), (json.dumps(e, indent=2) + "\n").encode())
                for sk in e.get("skills") or []:
                    if sk.get("blob") and SKILL_NAME.match(sk.get("name") or ""):
                        t = e.get("last_timestamp") or ""
                        if sk["name"] not in skills or t > skills[sk["name"]][0]:
                            skills[sk["name"]] = (t, sk["blob"])
                done += 1
            except (StoreError, ValueError, KeyError, OSError) as x:
                say(str(x) + "; session not written")
                failed += 1
        for name, (_, blob) in sorted(skills.items()):
            text = git_blob(repo_dir, blob) if re.match(r"^[0-9a-f]{40}$", blob) else None
            if text is None:
                say(f"skill {name}: blob {blob[:12]} is not in {repo_dir}; skipped")
                continue
            write_atomic(os.path.join(out, "skills", name, "SKILL.md"), text)
    except StoreError as x:
        say(str(x))
        return 1
    print(f"transcripts: materialized {done} sessions into {out}" + (f", {failed} failed" if failed else ""))
    return 1 if failed else 0

# ---- the store's text, for reading (record docs/changes/2026-11-15-readable-store.md) ----

TEXT_BYTES = 3_000_000  # the most one text may be in a request's body; a longer one is stored cut
ROWS_BYTES = 1_000_000  # the most a request of several rows may be; a row that is more goes alone
ROW_FIELDS = ("at", "who", "kind", "tool", "call_id", "failed", "side", "text")
AT = re.compile(r"^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(\.\d+)?(Z|[+-]\d\d:\d\d)$")
HALF_PAIR = re.compile("[\ud800-\udfff]")  # in a decoded string a surrogate is always a lone one


def body_bytes(v):
    """The bytes a value takes in a request's body, as `request` writes it: every non-ASCII character escaped."""
    return len(json.dumps(v, separators=(",", ":")))


def storable(s):
    """A string PostgreSQL can hold: U+0000 is shown as U+2400 and half of a surrogate pair as U+FFFD."""
    return HALF_PAIR.sub("\ufffd", s.replace("\x00", "\u2400"))


def instant(s):
    """The moment a timestamp names, when it has the form 2026-11-15T10:00:00Z (a fraction or none, Z or an
    offset) and is a real date; None for anything else."""
    m = AT.match(s) if isinstance(s, str) else None
    if not m:
        return None
    try:
        t = datetime(*(int(x) for x in m.group(1, 2, 3, 4, 5, 6)), tzinfo=timezone.utc)
        if m.group(8) != "Z":
            hours, minutes = int(m.group(8)[1:3]), int(m.group(8)[4:6])
            if hours > 15 or minutes > 59:
                return None
            t -= timedelta(hours=hours, minutes=minutes) * (1 if m.group(8)[0] == "+" else -1)
        return t + timedelta(microseconds=round(float("0" + m.group(7)) * 1_000_000) if m.group(7) else 0)
    except (ValueError, OverflowError):
        return None


def cut_text(t):
    """A text as one row may hold it: whole when its form in a request's body is at most TEXT_BYTES, else its
    longest beginning that is, with a last line saying how many characters were left in the chunk."""
    if len(t) * 12 + 2 <= TEXT_BYTES or body_bytes(t) <= TEXT_BYTES:
        return t

    def cut(k):
        return t[:k] + f"\n[cut here: {len(t) - k} more characters of this text are in the chunk]"
    fits, over = 0, len(t)  # one more character kept is never fewer bytes, so the longest that fits is found by halving
    while over - fits > 1:
        mid = (fits + over) // 2
        if body_bytes(cut(mid)) <= TEXT_BYTES:
            fits = mid
        else:
            over = mid
    return cut(fits)


def result_text(content):
    """A tool result's content as text: a string as it is, a list as its text blocks joined by a newline with
    each other block as its type in square brackets, nothing as an empty text, anything else as JSON."""
    if isinstance(content, str):
        return content
    if content is None:
        return ""
    if isinstance(content, list):
        return "\n".join(b["text"] if b["type"] == "text" and isinstance(b.get("text"), str) else f"[{b['type']}]"
                         for b in content if isinstance(b, dict) and b.get("type"))
    return json.dumps(content, sort_keys=True, ensure_ascii=False)


def message_rows(raw):
    """The rows of one chunk for `messages`, read from its redacted bytes: one for each text, tool call and
    tool result of each user or assistant line (the record's R4 says each field). The one rule both senders
    of rows use; a change to it is a change of SHAPE, with a fixture of its own in store/fixtures."""
    rows = []
    for n, line in enumerate(raw.split(b"\n"), 1):
        try:
            d = json.loads(line)
        except (ValueError, RecursionError):
            continue
        if not isinstance(d, dict) or d.get("type") not in ("user", "assistant"):
            continue
        content = d["message"].get("content") if isinstance(d.get("message"), dict) else None
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        at = d.get("timestamp") if instant(d.get("timestamp")) is not None else None

        def row(block, who, kind, text, tool=None, call_id=None, failed=False):
            tool, call_id = (storable(v)[:200] if isinstance(v, str) else None for v in (tool, call_id))
            rows.append({"shape": SHAPE, "line": n, "block": block, "at": at, "who": who, "kind": kind, "tool": tool,
                         "call_id": call_id, "failed": failed, "side": d.get("isSidechain") is True,
                         "text": cut_text(storable(text))})
        for b, block in enumerate(content if isinstance(content, list) else []):
            kind = block.get("type") if isinstance(block, dict) else None
            if kind == "text" and isinstance(block.get("text"), str) and block["text"].strip():
                row(b, "assistant" if d["type"] == "assistant" else
                    "context" if d.get("isMeta") is True or d.get("isCompactSummary") is True else "user", "text", block["text"])
            elif kind == "tool_use" and d["type"] == "assistant":
                row(b, "assistant", "call", json.dumps(block.get("input"), sort_keys=True, ensure_ascii=False),
                    tool=block.get("name"), call_id=block.get("id"))
            elif kind == "tool_result" and d["type"] == "user":
                row(b, "tool", "result", result_text(block.get("content")), call_id=block.get("tool_use_id"),
                    failed=block.get("is_error") is True)
    return rows


def row_requests(rows):
    """A chunk's rows cut into requests, in order: each body at most ROWS_BYTES, a row that is more alone.
    Whoever sends a chunk's rows cuts them by this, so its requests are the same from any sender."""
    out, cur, size = [], [], 2
    for r in rows:
        b = body_bytes(r) + (1 if cur else 0)
        if cur and size + b > ROWS_BYTES:
            out.append(cur)
            cur, size, b = [], 2, b - 1
        cur.append(r)
        size += b
    return out + ([cur] if cur else [])


def same_field(name, a, b):
    """Whether a row's field as the chunk gives it and as the table holds it are one value: a time is compared
    as the moment it names, since the table gives it back in its own form and to the microsecond."""
    if name != "at" or a is None or b is None:
        return a == b
    a, b = instant(a), instant(b)
    return a is not None and b is not None and abs(a - b) <= timedelta(microseconds=1)


def so_many(n, what):
    return f"{n} {what}{'' if n == 1 else 's'}"


MESSAGES_USAGE = "usage: transcripts messages [--session ID]... [--check]"


def cmd_messages(args):
    only, check, i = [], False, 0
    while i < len(args):
        if args[i] == "--session" and i + 1 < len(args):
            only.append(args[i + 1])
            i += 2
        elif args[i] == "--check":
            check, i = True, i + 1
        else:
            say(MESSAGES_USAGE)
            return 2
    try:
        url = store_url()
        if url is None:
            raise StoreError("messages needs AGENT_TRANSCRIPTS_URL, the store's URL")
        key = key_file("read-key", required=True)
    except StoreError as e:
        say(str(e))
        return 2
    sessions, chunks, inserted, none, left_out, unfilled, compared, probes = set(), 0, 0, 0, 0, 0, 0, 0
    found = {"missing": 0, "not the chunk's": 0, "differs": 0}
    held, orphans = set(), {}  # the chunks the store holds, and the rows of each chunk it does not
    try:
        if request(url, key, "GET", "/rest/v1/messages?select=line&limit=1")[0] == 404:
            say("the store has no table `messages` yet: run plugins/change-record/store/schema.sql in the project's SQL editor, "
                "then this again")
            return 1
        q = "/rest/v1/chunks?select=session_id,stream,chunk_id,sender,start_id&order=session_id,stream,chunk_id"
        scope = "&session_id=in.(" + ",".join(quote(x, safe="") for x in only) + ")" if only else ""
        for c in read_rows(url, key, q + scope):
            sid, stream, cid = c["session_id"], c["stream"], c["chunk_id"]
            held.add((sid, stream, cid))
            if sid.startswith("probe-") and c.get("sender") == "probe" and c.get("start_id") == "0" * 64:
                probes += 1  # what store/probe leaves behind: no transcript's chunk, and no chain the view shows can hold it
                continue
            where = f"session_id=eq.{quote(sid, safe='')}&stream=eq.{quote(stream, safe='')}&chunk_id=eq.{quote(cid, safe='')}"
            sessions.add(sid)
            chunks += 1
            try:
                got = read_rows(url, key, f"/rest/v1/chunks?select=start_id,data&{where}&order=chunk_id")[0]
                raw = gzip.decompress(base64.b64decode(got["data"]))
                if chunk_id(got["start_id"], raw) != cid:
                    raise ValueError("its bytes are not the ones its id was made from")
            except (IndexError, KeyError, TypeError, ValueError, EOFError, OSError, zlib.error):
                say(f"{sid} {stream}: chunk {cid[:12]} does not match its chain id; left out")
                left_out += 1
                continue
            reqs = chunk_requests(sid, stream, cid, raw)
            want = {(r["line"], r["block"]): r for req in reqs for r in req}
            there = {(r["line"], r["block"]): r for r in read_rows(
                url, key, f"/rest/v1/messages?select=line,block{',' + ','.join(ROW_FIELDS) if check else ''}"
                          f"&{where}&shape=eq.{SHAPE}&order=line,block")}
            if check:
                compared += len(there)
                for k in sorted(want.keys() | there.keys()):
                    differ = [f for f in ROW_FIELDS if k in want and k in there and not same_field(f, want[k][f], there[k].get(f))]
                    what = "missing" if k not in there else "not the chunk's" if k not in want else "differs" if differ else None
                    if what:
                        found[what] += 1
                        print(f"{what}{' (' + ', '.join(differ) + ')' if differ else ''}: {sid} {stream} chunk {cid[:12]} "
                              f"line {k[0]} block {k[1]}")
                continue
            added, failed = 0, None
            try:
                for req in reqs:
                    missing = [r for r in req if (r["line"], r["block"]) not in there]
                    if len(missing) == len(req) and insert(url, key, "messages", req):
                        added += len(req)  # none of it was there: the request goes whole
                    else:  # some of it is there, or was written while this ran: what is missing goes a row at a time
                        for r in missing:
                            added += insert(url, key, "messages", [r])  # counted as it goes: a later refusal loses none
            except StoreError as e:  # refused, or no answer: the other chunks are still tried
                failed = e
            inserted += added
            if failed:
                say(f"{sid} {stream}: chunk {cid[:12]} could not be filled: {failed}")
                unfilled += 1
            elif not added:
                none += 1
        if check:  # a row is its chunk's: one whose chunk the store does not hold, under any shape, has nothing behind it
            for r in read_rows(url, key, "/rest/v1/messages?select=session_id,stream,chunk_id"
                                         "&order=session_id,stream,chunk_id,shape,line,block" + scope):
                k = (r["session_id"], r["stream"], r["chunk_id"])
                if k not in held:
                    orphans[k] = orphans.get(k, 0) + 1
            for (sid, stream, cid), n in sorted(orphans.items()):
                print(f"no such chunk: {sid} {stream} chunk {cid[:12]}: {so_many(n, 'row')}")
    except StoreError as e:
        say(str(e))
        return 1
    tail = ((f", {so_many(left_out, 'chunk')} left out" if left_out else "")
            + (f", {so_many(probes, 'chunk')} of store/probe's passed over" if probes else ""))
    if check:
        m, x, d, o = found["missing"], found["not the chunk's"], found["differs"], sum(orphans.values())
        bad = [s for n, s in ((m, f"{so_many(m, 'row')} missing"),
                              (x, f"{so_many(x, 'row')} that {'is' if x == 1 else 'are'} not its chunk's"),
                              (d, f"{so_many(d, 'row')} that differ{'s' if d == 1 else ''}"),
                              (o, f"{so_many(o, 'row')} whose chunk the store does not hold")) if n]
        print(f"transcripts: messages --check: {so_many(chunks, 'chunk')}"
              + (f"; {', '.join(bad)}" if bad else f", {so_many(compared, 'row')}, each as its chunk gives it") + tail)
        return 1 if bad or left_out else 0
    print(f"transcripts: messages: read {so_many(chunks, 'chunk')} of {so_many(len(sessions), 'session')}, inserted "
          f"{so_many(inserted, 'row')}, {so_many(none, 'chunk')} needed none"
          + (f", {so_many(unfilled, 'chunk')} could not be filled" if unfilled else "") + tail)
    return 1 if left_out or unfilled else 0

# ---- grading ----

GRADER = "fields/3"  # bump when a grader's rules change, so scores from two rule sets are not mixed


def git_run(repo, *args):
    try:
        r = subprocess.run(["git", "-C", repo] + list(args), capture_output=True, timeout=20,
                           env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
    except (OSError, subprocess.SubprocessError):
        return 1, b""
    return r.returncode, r.stdout


def has_commit(repo, c):
    return bool(c) and re.match(r"^[0-9a-f]{7,40}$", c) is not None and git_run(repo, "cat-file", "-e", c + "^{commit}")[0] == 0


def record_reader(repo, commit, note):
    def read(path):
        if not commit:
            raise LookupError("no commit recorded for the session")
        if not has_commit(repo, commit):
            raise LookupError(f"commit {commit[:10]} is not in {repo}")
        rc, out = git_run(repo, "show", f"{commit}:{path}")
        if rc != 0:
            note(f"{path} is not in commit {commit[:10]}")
            return None
        return out.decode("utf-8", "replace")
    return read


def record_checker(repo, first, last, scratch):
    def check(path):
        if not last:
            raise LookupError("no commit recorded for the session")
        if not has_commit(repo, last):
            raise LookupError(f"commit {last[:10]} is not in {repo}")
        base = first if has_commit(repo, first) else (last + "^" if has_commit(repo, last + "^") else last)
        body = os.path.join(scratch, "body.md")
        with open(body, "w") as f:
            f.write(f"Change: {path}\n")
        try:
            r = subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "record-check"),
                                f"{base}..{last}", "--body", body, "--json"], cwd=repo, capture_output=True, text=True, timeout=60)
            res = json.loads(r.stdout.strip().splitlines()[-1])
        except (OSError, subprocess.SubprocessError, ValueError, IndexError) as e:
            raise LookupError(f"record-check did not run ({e})")
        good = res.get("status") == "pass"
        return ("pass" if good else "fail"), {
            "why": f"record-check: ok tier={res.get('tier')} mode={res.get('mode')}" if good else "; ".join(res.get("problems") or [])[:500],
            "problems": res.get("problems") or [], "mode": res.get("mode"), "base": res.get("base"), "head": res.get("head")}
    return check


def first_cwd(lines):
    for raw in lines:
        try:
            d = json.loads(raw)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("cwd"):
            return d["cwd"]
    return None


def session_lines(d, sid, entry):
    """The main transcript's lines from an archive (its parts) or a materialized folder."""
    if os.path.isdir(os.path.join(d, "parts", sid)):
        gen = ((entry.get("streams") or {}).get("main") or {}).get("generation", 1)
        files = sorted(glob.glob(os.path.join(d, "parts", sid, "main", f"g{gen}-*.jsonl")))
    else:
        files = sorted(glob.glob(os.path.join(d, "projects", "*", sid + ".jsonl")))
    if not files:
        raise LookupError("no transcript for the session")
    lines = b"".join(open(f, "rb").read() for f in files).splitlines()
    learn_ids(lines)  # what is shown from them passes through redact_text
    return lines


def change_skill(entry):
    for sk in (entry or {}).get("skills") or []:
        if sk.get("name") == "change" or str(sk.get("name") or "").endswith(":change"):
            return sk["name"], sk.get("blob")
    return "change-record:change", None


def grade_one(fields, lines, sid, entry, repo, scratch, note, root=None):
    last = ((entry or {}).get("last_stop") or {}).get("commit")
    try:  # where the session started: not its first stop, which is already the work of its first turn
        first = session_commits(repo, entry or {})[0]
    except LookupError:
        first = last  # no commit of its own: what was there when it began is what is there now
    if root is None:
        cwd = first_cwd(lines)
        root = (git(cwd, "rev-parse", "--show-toplevel") if cwd and os.path.isdir(cwd) else None) or cwd
    if entry is None:
        at_first = at_last = check = None
    else:
        at_first = record_reader(repo, first, lambda m: None)
        at_last = record_reader(repo, last, note)
        check = record_checker(repo, first, last, scratch)
    record, verdicts = fields.grade(lines, root, at_first, at_last, check)
    skill_name, blob = change_skill(entry)
    now = datetime.now().astimezone().isoformat(timespec="seconds")
    return record, [{"session_id": sid, "step": s, "verdict": v, "skill": skill_name, "skill_blob": blob,
                     "grader": GRADER, "evidence": ev, "graded_at": now} for s, v, ev in verdicts]


def cmd_grade(args):
    d, only, repo, store, transcript, cwd, i = None, [], os.getcwd(), False, None, None, 0
    while i < len(args):
        a = args[i]
        if a in ("--session", "--repo-dir", "--transcript", "--cwd") and i + 1 < len(args):
            v = args[i + 1]
            if a == "--session":
                only.append(v)
            elif a == "--repo-dir":
                repo = v
            elif a == "--transcript":
                transcript = v
            else:
                cwd = v
            i += 2
        elif a == "--store":
            store, i = True, i + 1
        elif d is None and not a.startswith("--"):
            d, i = a, i + 1
        else:
            say("usage: transcripts grade [DIR] [--session ID]... [--repo-dir DIR] [--store] | grade --transcript FILE [--cwd DIR]")
            return 2
    sys.dont_write_bytecode = True  # no __pycache__ beside the plugin's code
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "grade"))
    import fields
    import tempfile
    repo = os.path.abspath(repo)
    if transcript:
        try:
            lines = read_transcript(transcript)
            sid = os.path.basename(transcript).split(".")[0]
            _, rows = grade_one(fields, lines, sid, None, repo, None, say, root=os.path.abspath(cwd) if cwd else None)
        except (OSError, fields.Unparsable) as e:
            say(f"{transcript}: {e}")
            return 1
        for r in rows:
            print(json.dumps(r))
        return 0
    try:
        if d is None:
            d = archive_dir()
            if d is None:
                raise PermissionError("grade needs DIR, or AGENT_TRANSCRIPTS set to the archive")
        else:
            d = os.path.abspath(d)
            tree = inside_work_tree(d)
            if tree:
                raise PermissionError(f"{d} is inside the working tree of {tree}; scores are written beside the transcripts")
        url = key = None
        if store:
            url = store_url()
            if url is None:
                raise StoreError("--store needs AGENT_TRANSCRIPTS_URL, the store's URL")
            key = key_file("read-key", required=True)
    except (PermissionError, StoreError) as e:
        say(str(e))
        return 2
    sids = sorted(os.path.basename(p)[:-5] for p in glob.glob(os.path.join(d, "sessions", "*.json")))
    sids = [s for s in sids if not only or s in only]
    graded = failed = stored = 0
    with tempfile.TemporaryDirectory() as scratch:
        for sid in sids:
            notes = []
            try:
                entry = json.load(open(os.path.join(d, "sessions", sid + ".json")))
                lines = session_lines(d, sid, entry)
                record, rows = grade_one(fields, lines, sid, entry, repo, scratch, notes.append)
            except (OSError, ValueError, LookupError, fields.Unparsable) as e:
                say(f"{sid}: {e}; not graded")
                failed += 1
                continue
            for n in notes:
                say(f"{sid}: {n}")
            errors = [r["evidence"]["error"] for r in rows if r["evidence"].get("error")]
            for e in sorted(set(errors)):
                say(f"{sid}: {e}; the steps that need it are not graded")
            failed += bool(errors)
            write_atomic(os.path.join(d, "scores", sid + ".json"), (json.dumps(rows, indent=2) + "\n").encode())
            graded += 1
            print(f"{sid[:8]} record {record or 'none'}")
            for r in rows:
                print(f"{sid[:8]} {r['step']} {r['verdict']} {r['evidence'].get('why', '')}")
            if store:
                try:
                    for r in rows:
                        stored += insert(url, key, "scores", r)
                except StoreError as e:
                    say(f"{sid}: {e}; its rows are kept in {d}/scores")
                    failed += 1
                    store = False
    print(f"transcripts: graded {graded} sessions into {d}/scores" + (f", {failed} with problems" if failed else "")
          + (f"; stored {stored} score rows at {url}" if url else ""))
    return 1 if failed else 0


# ---- labels: the sheet a person labels from, and the graders' accuracy against the labels ----

def labels_args(args, usage, takes):
    """DIR, --transcript FILE..., and the options in takes; None after a usage message."""
    o, i = {"dir": None, "files": [], "only": [], "repo": os.getcwd(), "out": None,
            "labels": os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "grade", "labels")}, 0
    names = {"--session": "only", "--repo-dir": "repo", "--labels": "labels", "--out": "out"}
    while i < len(args):
        a = args[i]
        if a in names and names[a] in takes and i + 1 < len(args):
            if a == "--session":
                o["only"].append(args[i + 1])
            else:
                o[names[a]] = args[i + 1]
            i += 2
        elif a == "--transcript" and i + 1 < len(args) and not args[i + 1].startswith("--"):
            i += 1
            while i < len(args) and not args[i].startswith("--"):
                o["files"].append(args[i])
                i += 1
        elif o["dir"] is None and not a.startswith("--"):
            o["dir"], i = a, i + 1
        else:
            o = None
            break
    if o is None or (o["files"] and (o["dir"] or o["only"])) or bool(o["out"]) != bool(o["files"] and "out" in takes):
        say(usage)
        return None
    o["labels"], o["repo"] = os.path.abspath(o["labels"]), os.path.abspath(o["repo"])
    return o


def load_labels_modules():
    sys.dont_write_bytecode = True  # no __pycache__ beside the plugin's code
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "grade"))
    import fields
    import labels
    return fields, labels


def read_transcript(path):
    """The lines of a transcript file, gzipped or not; the account ids in them are learned."""
    lines = (gzip.open(path) if path.endswith(".gz") else open(path, "rb")).read().splitlines()
    learn_ids(lines)
    return lines


def transcript_file(path):
    """(session id, lines) of a transcript file, gzipped or not; the id is the one its lines carry."""
    lines = read_transcript(path)
    sid = None
    for raw in lines:
        try:
            d = json.loads(raw)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("sessionId"):
            sid = str(d["sessionId"])
            break
    if not sid or not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*$", sid):
        sid = os.path.basename(path).split(".")[0]
    return sid, lines


def leave_label(labels, folder, sid, lines):
    """Write the label file to fill in, unless a person has written in the one there. Returns new, kept or stale."""
    path = os.path.join(folder, sid + ".txt")
    sha, n = labels.transcript_hash(lines)
    if os.path.exists(path):
        label, bad = labels.parse(open(path, encoding="utf-8", errors="replace").read())
        if bad:
            say(f"{path}: {bad[0]}; left as it is")
            return "kept"
        if label["sha256"] == sha:
            return "kept"
        if any(v or reason for v, reason in label["steps"].values()) or label["by"]:
            say(f"{path} is stale: it was made from a transcript of {label['lines']} lines, which now has {n}. Its verdicts "
                "are kept and will not be counted; label the session again from the new sheet, or delete the file and run sheet again")
            return "stale"
    os.makedirs(folder, exist_ok=True)
    with open(path, "w") as f:
        f.write(labels.stub(sid, sha, n))
    os.chmod(path, 0o644)  # a label file is meant to be committed; it holds no transcript text
    return "new"


def read_answers(d):
    """The kept answers of the two measures in DIR, as grade/claims.py takes them: each file is named for its
    session (repeats/<sessionId>.json) or for its session and model (reviews/<sessionId>/<model>/review.json)."""
    answers = {"repeats": {}, "reviews": {}}
    for p in sorted(glob.glob(os.path.join(d, "repeats", "*.json"))):
        answers["repeats"][os.path.basename(p)[:-5]] = read_json(p)
    for p in sorted(glob.glob(os.path.join(d, "reviews", "*", "*", "review.json"))):
        sid, model = p.split(os.sep)[-3:-1]
        answers["reviews"].setdefault(sid, {})[model] = read_json(p)
    return answers


SHEET_USAGE = ("usage: transcripts sheet [DIR] [--session ID]... [--repo-dir DIR] [--labels DIR] | "
               "sheet --transcript FILE... --out DIR [--labels DIR]")


def cmd_sheet(args):
    o = labels_args(args, SHEET_USAGE, ("only", "repo", "labels", "out"))
    if o is None:
        return 2
    fields, labels = load_labels_modules()
    try:
        if o["files"]:
            out = os.path.abspath(o["out"])
            tree = inside_work_tree(out)
            if tree:
                raise PermissionError(f"{out} is inside the working tree of {tree}; sheets hold transcript text and are kept out of it")
            todo = [(None, f) for f in o["files"]]
        else:
            d = folder_arg(o["dir"])
            out = os.path.join(d, "sheets")
            sids = sorted(os.path.basename(p)[:-5] for p in glob.glob(os.path.join(d, "sessions", "*.json")))
            todo = [(s, None) for s in sids if not o["only"] or s in o["only"]]
    except PermissionError as e:
        say(str(e))
        return 2
    import claims
    answers = read_answers(d) if not o["files"] else {}  # a transcript file alone has no folder of answers
    done, failed, made = 0, 0, {"new": 0, "kept": 0, "stale": 0}
    for sid, path in todo:
        try:
            if path:
                sid, lines = transcript_file(path)
                records, commits = None, None
            else:
                entry = json.load(open(os.path.join(d, "sessions", sid + ".json")))
                lines = session_lines(d, sid, entry)
                last, records = (entry.get("last_stop") or {}).get("commit"), []
                try:
                    commits = session_commits(o["repo"], entry)
                except LookupError:
                    commits = None
                for rec in labels.named_records(lines)[:3]:
                    try:
                        text = record_reader(o["repo"], last, lambda m: None)(rec)
                        records.append((rec, text, None if text is not None else "it is not in the session's last commit"))
                    except LookupError as e:
                        records.append((rec, None, f"it cannot be read ({e})"))
            text = labels.sheet(lines, sid, os.path.join(o["labels"], sid + ".txt"), records, redact_text, commits,
                                claims.sheet_lines(sid, answers, redact_text))
        except (OSError, ValueError, LookupError, fields.Unparsable) as e:
            say(f"{path or sid}: {e}; no sheet")
            failed += 1
            continue
        write_atomic(os.path.join(out, sid + ".md"), text.encode())
        made[leave_label(labels, o["labels"], sid, lines)] += 1
        done += 1
    print(f"transcripts: wrote {done} sheets into {out}" + (f", {failed} failed" if failed else "")
          + f"; label files in {o['labels']}: {made['new']} new, {made['kept']} kept" + (f", {made['stale']} stale" if made["stale"] else ""))
    return 1 if failed else 0


ACCURACY_USAGE = "usage: transcripts accuracy [DIR] [--labels DIR] | accuracy --transcript FILE... [--labels DIR]"


def cmd_accuracy(args):
    o = labels_args(args, ACCURACY_USAGE, ("labels",))
    if o is None:
        return 2
    fields, labels = load_labels_modules()
    here, problems = {}, 0
    if o["files"]:
        for path in o["files"]:
            try:
                sid, lines = transcript_file(path)
                _, rows = grade_one(fields, lines, sid, None, o["repo"], None, lambda m: None)
            except (OSError, fields.Unparsable) as e:
                say(f"{path}: {e}; not compared")
                problems += 1
                continue
            here[sid] = dict(zip(("sha256", "lines"), labels.transcript_hash(lines)), rows=rows)
    else:
        try:  # accuracy only reads, so DIR may be anywhere, a repository's fixtures included
            d = os.path.abspath(o["dir"]) if o["dir"] else folder_arg(None)
        except PermissionError as e:
            say(str(e))
            return 2
        for p in sorted(glob.glob(os.path.join(d, "sessions", "*.json"))):
            sid = os.path.basename(p)[:-5]
            try:
                lines = session_lines(d, sid, read_json(p, {}) or {})
            except (OSError, LookupError) as e:
                say(f"{sid}: {e}; not compared")
                problems += 1
                continue
            rows = read_json(os.path.join(d, "scores", sid + ".json"))
            here[sid] = dict(zip(("sha256", "lines"), labels.transcript_hash(lines)), rows=rows if isinstance(rows, list) else None)
    if not os.path.isdir(o["labels"]):
        say(f"no labels folder at {o['labels']}")
        return 2
    found, bad = labels.load(o["labels"])
    for name, why in bad:
        say(f"{os.path.join(o['labels'], name)}: {why}; the file is rejected")
    sys.stdout.write(labels.table(labels.compare(found, here), len(here), len(found) + len({n for n, _ in bad})))
    return 1 if bad or problems else 0


# ---- the judge and the report ----

def load_grade_modules():
    sys.dont_write_bytecode = True  # no __pycache__ beside the plugin's code
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "grade"))
    import fields
    import judge
    import report
    return fields, judge, report


def session_root(lines):
    cwd = first_cwd(lines)
    return (git(cwd, "rev-parse", "--show-toplevel") if cwd and os.path.isdir(cwd) else None) or cwd


def folder_arg(d):
    """The folder grade, judge and report work on: DIR, else the archive AGENT_TRANSCRIPTS names."""
    if d is None:
        d = archive_dir()
        if d is None:
            raise PermissionError("needs DIR, or AGENT_TRANSCRIPTS set to the archive")
        return d
    d = os.path.abspath(d)
    tree = inside_work_tree(d)
    if tree:
        raise PermissionError(f"{d} is inside the working tree of {tree}; scores are written beside the transcripts")
    return d


def read_json(path, default=None):
    try:
        return json.load(open(path))
    except (OSError, ValueError):
        return default


JUDGE_USAGE = ("usage: transcripts judge [DIR] [--session ID]... [--repo-dir DIR] [--judge claude|opencode] [--limit N] "
               "[--store] [--verbose]\n"
               "       transcripts judge --transcript FILE --record FILE [--judge claude|opencode]\n"
               "--limit: sessions judged per run, newest first (default 20 for claude, the Haiku judge; 10 for opencode, "
               "the agreement check)")


def show_judged(sid, res, verbose):
    for q, r in res.items():
        statuses = " ".join(v["status"] for v in r["votes"])
        print(f"{sid[:8]} {q} {r['verdict']}" + (f" ({statuses})" if statuses else "") + f" {r['why']}")
        if not verbose:
            continue
        if r.get("prompt"):
            print("  prompt:")
            print("\n".join("    " + ln for ln in r["prompt"].splitlines()))
        for v in r["votes"]:
            if v["status"] == "vote":
                print(f"  vote {v['vote']}: {v['verdict']}: {v['reason']}")
            else:
                print(f"  vote {v['vote']}: not counted, {v['status']}: {v['detail']}; answer {v['answer'][:300]!r}")
        print(f"  verdict: {r['verdict']}")


def session_commits(repo, entry):
    """(base, last) of a session's own commits. last is the commit at its last stop. base is the
    newest commit on last's own line (first parents) made before the session's first line, or
    None when that line began with the session. The commit at the first stop is no base: it is
    already the work of the session's first turn. Raises LookupError when there is no commit to
    name: none recorded, one this repository does not have, or a last commit made before the
    session began."""
    last = (entry.get("last_stop") or {}).get("commit")
    if not last:
        raise LookupError("no commit recorded for the session")
    try:
        began = int(datetime.fromisoformat(str(entry.get("first_timestamp")).replace("Z", "+00:00")).timestamp())
    except ValueError:
        raise LookupError("the session's start time is not known")
    rc, out = git_run(repo, "rev-list", "-1", "--first-parent", f"--before={began}", last)
    base = out.decode().strip()
    if rc != 0:
        raise LookupError(f"commit {last[:10]} cannot be read in {repo}")
    if base == last:
        raise LookupError("the session made no commit")
    return base or None, last


ASKED_AGAIN = "a question left with no verdict is asked again at the next run"


def errors_in(questions, asked):
    """How many of the answers to the questions just asked were errors: no judge, no answer in time, another model."""
    return sum(1 for q in asked for v in questions[q]["votes"] if v["status"] == "error")


def judged_rows(undecided, entry, doc):
    """[(table, row)] for one judged record, as the store takes them. Each row carries the time
    its question was judged, so a row sent again is the row the store has."""
    sid, kind, model = doc["session_id"], doc["kind"], doc["model"]
    skill_name, blob = change_skill(entry)
    rows = []
    for q, r in doc["questions"].items():
        at = r.get("judged_at") or doc["judged_at"]
        if kind == "claude" and r["verdict"] != undecided:  # the agreement judge's verdicts are a check on these, not scores
            rows.append(("scores", {
                "session_id": sid, "step": q, "verdict": r["verdict"], "skill": skill_name, "skill_blob": blob,
                "grader": f"{doc['judge']}:{model}", "graded_at": at,
                "evidence": {"why": r["why"], "record": doc["record"], "votes": [v["status"] for v in r["votes"]],
                             "prompt_sha256": r.get("prompt_sha256"), "judge_file": f"judges/{sid}.{kind}.json"}}))
    for q, r in doc["questions"].items():
        for v in r["votes"]:
            rows.append(("judge_votes", {
                "session_id": sid, "question": q, "judge": f"{doc['judge']}:{kind}:{model}",
                "vote": v["vote"], "status": v["status"], "verdict": v["verdict"], "reason": v["reason"],
                "detail": v["detail"], "answer": v["answer"], "served_model": v["served_model"],
                "prompt": r["prompt"], "prompt_sha256": r["prompt_sha256"], "record": doc["record"],
                "record_sha256": doc["record_sha256"], "judged_at": r.get("judged_at") or doc["judged_at"]}))
    return rows


def send_judged(url, key, path, doc, rows):
    """Insert one session's rows, then mark its judge file as stored; the number the store took as new."""
    n = sum(insert(url, key, table, row) for table, row in rows)
    doc["stored_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
    write_atomic(path, (json.dumps(doc, indent=2) + "\n").encode())
    return n


REPEATS_USAGE = ("usage: transcripts judge --repeats [DIR] (--session ID... | --limit N) [--again]\n"
                 "       transcripts judge --repeats --transcript FILE... --out DIR [--again]\n"
                 "Each chosen session's closing message goes, redacted, to Claude Sonnet, which lists what it says twice; "
                 "the answers are kept in DIR/repeats. --limit: the newest N sessions not yet answered. "
                 "--again: ask though an answer is kept.")


def cmd_repeats(args):
    """judge --repeats: the share of each chosen session's closing message that is said twice (grade/repeats.py)."""
    d, only, limit, again, files, out, i = None, [], None, False, [], None, 0
    while i < len(args):
        a = args[i]
        if a in ("--session", "--limit", "--out") and i + 1 < len(args):
            if a == "--session":
                only.append(args[i + 1])
            elif a == "--limit":
                limit = int(args[i + 1]) if args[i + 1].isdigit() else -1
            else:
                out = args[i + 1]
            i += 2
        elif a == "--transcript":
            i += 1
            while i < len(args) and not args[i].startswith("--"):
                files.append(args[i])
                i += 1
        elif a == "--again":
            again, i = True, i + 1
        elif d is None and not a.startswith("--"):
            d, i = a, i + 1
        else:
            say(REPEATS_USAGE)
            return 2
    if (limit is not None and limit < 1) or (files and (d or only or limit)) or (out and not files) or ("--transcript" in args and not files):
        say(REPEATS_USAGE)
        return 2
    if files and not out:
        say("--transcript needs --out DIR, a folder outside every working tree, for the answers")
        return 2
    if not files and not only and limit is None:
        say("nothing was sent: choose the sessions whose closing message goes to Claude Sonnet with --session ID or --limit N "
            "(the newest N)")
        return 2
    fields, _, _ = load_grade_modules()
    import repeats
    try:
        d = folder_arg(out if files else d)
    except PermissionError as e:
        say(str(e))
        return 2
    found = []  # (newest first, session id, the transcript's lines or why there are none)
    if files:
        for path in files:
            try:
                lines = read_transcript(path)
            except OSError as e:
                lines = e
            sid = os.path.basename(path).split(".")[0]
            if not isinstance(lines, Exception):
                sid = next((m.group(1).decode() for m in (re.search(rb'"sessionId":"([^"]+)"', ln) for ln in lines) if m), sid)
            found.append((sid, lines))
    else:
        entries = {os.path.basename(p)[:-5]: read_json(p, {}) or {} for p in glob.glob(os.path.join(d, "sessions", "*.json"))}
        for sid in sorted((s for s in entries if not only or s in only),
                          key=lambda s: (entries[s].get("last_timestamp") or "", s), reverse=True):
            try:
                found.append((sid, session_lines(d, sid, entries[sid])))
            except (OSError, LookupError) as e:
                found.append((sid, e))
        for sid in only:
            if sid not in entries:
                found.append((sid, LookupError(f"no session {sid} in {d}/sessions")))
    todo, already, skipped = [], 0, 0
    for sid, lines in found:
        why = str(lines) if isinstance(lines, Exception) else None
        if why is None:
            try:
                closing = repeats.closing_message(lines)
            except fields.Unparsable as e:
                closing, why = None, str(e)
            if closing is None and why is None:
                why = "the session wrote no message"
        if why is not None:
            print(f"{sid[:8]} not asked: {why}")
            skipped += 1
            continue
        message, described = repeats.describe(closing[1], redact_text)
        if not again and repeats.answered(read_json(os.path.join(d, "repeats", sid + ".json")), described):
            already += 1
            continue
        todo.append((sid, message, dict(described, entry=closing[0])))
    left = max(0, len(todo) - limit) if limit else 0
    todo = todo[:limit] if limit else todo
    if todo:
        n = len(todo)
        print(f"transcripts: {n} session{'s' if n != 1 else ''} to send to Claude Sonnet, {n} call{'s' if n != 1 else ''}, "
              f"at most ${n * repeats.BUDGET:.2f}: {', '.join(s[:8] for s, _, _ in todo)}", flush=True)
    asked = uncounted = 0
    cost = 0.0
    for sid, message, described in todo:
        doc = dict(repeats.judge_message(message, redact_text), session_id=sid, message=described,
                   asked_at=datetime.now().astimezone().isoformat(timespec="seconds"))
        write_atomic(os.path.join(d, "repeats", sid + ".json"), (json.dumps(doc, indent=2) + "\n").encode())
        asked += 1
        cost += doc.get("cost_usd") or 0
        if doc["status"] != "counted":
            uncounted += 1
            print(f"{sid[:8]} repeats: not counted ({doc['status']}): {doc['detail']}")
            continue
        extra = [f"{doc['quotes_not_found']} quote{'s' if doc['quotes_not_found'] != 1 else ''} not found" if doc["quotes_not_found"] else "",
                 f"{doc['same_quote_twice']} pair{'s' if doc['same_quote_twice'] != 1 else ''} that {'are' if doc['same_quote_twice'] != 1 else 'is'} one quote twice"
                 if doc["same_quote_twice"] else ""]
        share = "no point counted" if doc["share"] is None else f"{doc['said_again']} of {doc['points']} points said again ({doc['share']:.2f})"
        print(f"{sid[:8]} repeats: {share}" + "".join("; " + ", ".join(x for x in extra if x) for _ in [0] if any(extra)))
    print(f"transcripts: repeats asked of {asked} session{'s' if asked != 1 else ''} into {d}/repeats, ${cost:.2f}"
          + (f"; {already} already answered" if already else "") + (f"; {skipped} not asked" if skipped else "")
          + (f"; {uncounted} not counted, asked again at the next run" if uncounted else "")
          + (f"; {left} left for the next run (--limit {limit})" if left else ""))
    return 1 if uncounted else 0


REVIEW_USAGE = ("usage: transcripts judge --review [DIR] (--session ID... | --limit N) [--repo-dir REPO] [--model sonnet|opus] "
                "[--again] [--local]\n"
                "A reviewer that runs the code reviews each chosen session's own commits in REPO (default: here) and leaves "
                "each defect as a script, which the tool runs again at the session's last commit and at its base; the answers "
                "are kept in DIR/reviews. --limit: the newest N sessions not yet reviewed, at most 10 a run. --model sonnet|opus "
                "(default sonnet). --again: review though a review is kept. --local: run the scripts with no box.")


def cmd_review(args):
    """judge --review: the defects a boxed reviewer can show in each chosen session's commits (grade/review.py)."""
    d, only, limit, again, local, model, repo, i = None, [], None, False, False, "sonnet", os.getcwd(), 0
    while i < len(args):
        a = args[i]
        if a in ("--session", "--limit", "--model", "--repo-dir") and i + 1 < len(args):
            v = args[i + 1]
            if a == "--session":
                only.append(v)
            elif a == "--limit":
                limit = int(v) if v.isdigit() else -1
            elif a == "--model":
                model = v
            else:
                repo = v
            i += 2
        elif a in ("--again", "--local"):
            again, local = again or a == "--again", local or a == "--local"
            i += 1
        elif d is None and not a.startswith("--"):
            d, i = a, i + 1
        else:
            say(REVIEW_USAGE)
            return 2
    load_grade_modules()
    import review
    if model not in review.MODELS or (limit is not None and limit < 1):
        say(REVIEW_USAGE)
        return 2
    if not only and limit is None:
        say("nothing was reviewed: choose the sessions whose commits a reviewer is run on with --session ID or --limit N "
            "(the newest N)")
        return 2
    if (limit or 0) > review.MAX_SESSIONS or len(only) > review.MAX_SESSIONS:
        say(f"at most {review.MAX_SESSIONS} sessions are reviewed in one run")
        return 2
    try:
        d = folder_arg(d)
    except PermissionError as e:
        say(str(e))
        return 2
    repo = os.path.realpath(repo)
    boxed = review.box_available()
    if not boxed and not local:
        say("no box can be started here for the reviewer's scripts (bwrap). They are shell commands a model wrote; with --local "
            "they run with your own access")
        return 2
    entries = {os.path.basename(p)[:-5]: read_json(p, {}) or {} for p in glob.glob(os.path.join(d, "sessions", "*.json"))}
    todo, already, skipped = [], 0, 0
    for sid in [s for s in only if s not in entries]:
        print(f"{sid[:8]} not reviewed: no session {sid} in {d}/sessions")
        skipped += 1
    for sid in sorted((s for s in entries if not only or s in only), key=lambda s: (entries[s].get("last_timestamp") or "", s), reverse=True):
        try:
            base, last = session_commits(repo, entries[sid])
            why = None if base else "its commits have no base (its line began with the session)"
        except LookupError as e:
            why = str(e)
        if why:
            print(f"{sid[:8]} not reviewed: {why}")
            skipped += 1
        elif not again and review.reviewed(read_json(os.path.join(d, "reviews", sid, model, "review.json")), model, last):
            already += 1
        else:
            todo.append((sid, base, last))
    left = max(0, len(todo) - limit) if limit else 0
    todo = todo[:limit] if limit else todo
    done = uncounted = 0
    cost = 0.0
    if todo:
        n = len(todo)
        print(f"transcripts: {n} session{'s' if n != 1 else ''} to review with Claude {model.capitalize()}, {n + 1} calls "
              f"(1 to check the sandbox), at most ${n * review.BUDGET + review.CHECK_BUDGET:.2f}: {', '.join(s[:8] for s, _, _ in todo)}",
              flush=True)
        if not boxed:
            print("transcripts: no box could be started here: the reviewer's scripts run with your own access (--local)", flush=True)
        root = tempfile.mkdtemp(prefix="transcripts-review-")
        try:
            settings = os.path.join(root, "settings.json")
            review.write_settings(settings, [repo, d])
            wrong = review.check_sandbox(root, repo, settings)
            if wrong:
                say(f"nothing was reviewed: the reviewer's sandbox does not hold: {wrong}")
                return 1
            hidden = [repo, d, os.path.realpath(HOME)]
            for sid, base, last in todo:
                out = os.path.join(d, "reviews", sid, model)
                doc = dict(review.review_session(root, repo, base, last, model, settings, hidden, boxed, out, redact_text),
                           session_id=sid, reviewed_at=datetime.now().astimezone().isoformat(timespec="seconds"))
                write_atomic(os.path.join(out, "review.json"), (json.dumps(doc, indent=2) + "\n").encode())
                done += 1
                cost += doc.get("cost_usd") or 0
                uncounted += doc["status"] != "reviewed"
                print(f"{sid[:8]} review: {review.summary(doc)}", flush=True)
        finally:
            shutil.rmtree(root, ignore_errors=True)
    print(f"transcripts: {model} reviewed {done} session{'s' if done != 1 else ''} into {d}/reviews, ${cost:.2f}"
          + (f"; {already} already reviewed" if already else "") + (f"; {skipped} not reviewed" if skipped else "")
          + (f"; {uncounted} not counted, reviewed again at the next run" if uncounted else "")
          + (f"; {left} left for the next run (--limit {limit})" if left else ""))
    return 1 if uncounted else 0


def cmd_judge(args):
    if "--repeats" in args:
        return cmd_repeats([a for a in args if a != "--repeats"])
    if "--review" in args:
        return cmd_review([a for a in args if a != "--review"])
    d, only, repo, kind, limit, store, verbose, transcript, record_file, i = None, [], os.getcwd(), "claude", None, False, False, None, None, 0
    while i < len(args):
        a = args[i]
        if a == "--rubrics":
            say("judge --rubrics was taken out: both rubric judges were wrong on more than one labelled session in five "
                "(plugins/change-record/grade/rubrics/README.md has the measurements)")
            return 2
        if a in ("--session", "--repo-dir", "--judge", "--limit", "--transcript", "--record") and i + 1 < len(args):
            v = args[i + 1]
            if a == "--session":
                only.append(v)
            elif a == "--repo-dir":
                repo = v
            elif a == "--judge":
                kind = v
            elif a == "--limit":
                limit = int(v) if v.isdigit() else -1
            elif a == "--transcript":
                transcript = v
            else:
                record_file = v
            i += 2
        elif a in ("--store", "--verbose"):
            store, verbose = store or a == "--store", verbose or a == "--verbose"
            i += 1
        elif d is None and not a.startswith("--"):
            d, i = a, i + 1
        else:
            say(JUDGE_USAGE)
            return 2
    if kind not in ("claude", "opencode") or (limit is not None and limit < 1) or bool(transcript) != bool(record_file):
        say(JUDGE_USAGE)
        return 2
    fields, judge, _ = load_grade_modules()
    limit = limit or (20 if kind == "claude" else 10)
    if transcript:
        try:
            lines = read_transcript(transcript)
            text = open(record_file).read()
            commands = fields.commands_run(lines)
        except (OSError, fields.Unparsable) as e:
            say(f"{transcript}: {e}")
            return 1
        sid = next((m.group(1).decode() for m in (re.search(rb'"sessionId":"([^"]+)"', ln) for ln in lines) if m),
                   os.path.basename(transcript).split(".")[0])
        path = "docs/changes/" + os.path.basename(record_file)
        state = "judge" if judge.section(text, "Outcome") else "empty"
        show_judged(sid, judge.judge_record(kind, path, text, commands, state, redact_text), True)
        return 0
    try:
        d = folder_arg(d)
        url = key = None
        if store:
            url = store_url()
            if url is None:
                raise StoreError("--store needs AGENT_TRANSCRIPTS_URL, the store's URL")
            key = key_file("read-key", required=True)
    except (PermissionError, StoreError) as e:
        say(str(e))
        return 2
    repo = os.path.abspath(repo)
    sids = sorted(os.path.basename(p)[:-5] for p in glob.glob(os.path.join(d, "sessions", "*.json")))
    sids = [s for s in sids if not only or s in only]
    todo, skipped, already, problems, owed = [], 0, 0, 0, []
    for sid in sids:
        entry = read_json(os.path.join(d, "sessions", sid + ".json"), {})
        rows = read_json(os.path.join(d, "scores", sid + ".json"))
        record = next(((r.get("evidence") or {}).get("record") for r in rows or [] if (r.get("evidence") or {}).get("record")), None)
        why = None
        if not rows:
            why = "not graded yet (run transcripts grade first)"
        elif not record:
            why = "no record"
        if why is None:
            try:
                lines = session_lines(d, sid, entry)
                if not fields.code_written(lines, session_root(lines)):
                    why = "no code written"
            except (OSError, LookupError, fields.Unparsable) as e:
                why = str(e)
        if why is None:
            last = (entry.get("last_stop") or {}).get("commit")
            try:
                text = record_reader(repo, last, lambda m: None)(record)
            except LookupError as e:
                text, why = None, f"the record cannot be read: {e}"
            if text is None and why is None:
                why = f"{record} is not in the session's last commit"
        if why is not None:
            print(f"{sid[:8]} not judged: {why}")
            skipped += 1
            continue
        rsha = hashlib.sha256(text.encode()).hexdigest()
        if kind == "opencode":
            mine = read_json(os.path.join(d, "judges", f"{sid}.claude.json"), {})
            if mine.get("judge") != judge.JUDGE or mine.get("record_sha256") != rsha:
                print(f"{sid[:8]} not judged: the Haiku judge has not judged this record")
                skipped += 1
                continue
        have = read_json(os.path.join(d, "judges", f"{sid}.{kind}.json"), {})
        keep = None
        if have.get("judge") == judge.JUDGE and have.get("record_sha256") == rsha:
            if all(r["verdict"] != judge.UNDECIDED for r in have["questions"].values()):
                already += 1
                if store and not have.get("stored_at"):
                    owed.append((sid, entry, have))
                continue
            # a question with no verdict is asked again; the others stay as they were judged
            keep = {q: dict(r, judged_at=r.get("judged_at") or have["judged_at"]) for q, r in have["questions"].items()}
        outcome = next((r["verdict"] for r in rows if r.get("step") == "outcome-filled"), "not_applicable")
        state = {"pass": "judge", "fail": "empty"}.get(outcome, "not_done")
        todo.append((entry.get("last_timestamp") or "", sid, entry, record, text, rsha, fields.commands_run(lines), state, keep))
    todo.sort(key=lambda t: (t[0], t[1]), reverse=True)
    judged = stored = 0
    for _, sid, entry, record, text, rsha, commands, state, keep in todo[:limit]:
        res = judge.judge_record(kind, record, text, commands, state, redact_text, keep=keep)
        now = datetime.now().astimezone().isoformat(timespec="seconds")
        asked = [q for q, r in res.items() if not (keep and r is keep.get(q))]
        for q in asked:
            res[q]["judged_at"] = now
        doc = {"session_id": sid, "judge": judge.JUDGE, "kind": kind, "model": judge.MODELS[kind], "record": record,
               "record_sha256": rsha, "judged_at": now, "questions": res}
        write_atomic(os.path.join(d, "judges", f"{sid}.{kind}.json"), (json.dumps(doc, indent=2) + "\n").encode())
        judged += 1
        show_judged(sid, res, verbose)
        errors = errors_in(res, asked)
        if errors:
            say(f"{sid[:8]}: {errors} of the judge's answers were errors; {ASKED_AGAIN}")
            problems += 1
        if kind == "claude":
            write_atomic(os.path.join(d, "scores", sid + ".judge.json"),
                         (json.dumps([r for t, r in judged_rows(judge.UNDECIDED, entry, doc) if t == "scores"], indent=2) + "\n").encode())
        if store:
            owed.append((sid, entry, doc))
    for sid, entry, doc in owed:  # judged now, or at an earlier run that did not store or could not
        try:
            stored += send_judged(url, key, os.path.join(d, "judges", f"{sid}.{kind}.json"), doc, judged_rows(judge.UNDECIDED, entry, doc))
        except StoreError as e:
            say(f"{sid}: {e}; its rows are kept in {d}")
            problems += 1
            break
    left = max(0, len(todo) - limit)
    print(f"transcripts: {kind} judge ({judge.MODELS[kind]}) judged {judged} sessions into {d}/judges"
          + (f"; {already} already judged" if already else "") + (f"; {skipped} not judged" if skipped else "")
          + (f"; {left} left for the next run (--limit {limit})" if left else "")
          + (f"; stored {stored} rows at {url}" if url else ""))
    return 1 if problems else 0


PROPOSE_USAGE = "usage: transcripts propose [DIR] --session ID --step STEP [--labels DIR] [--repo-dir DIR]"


def cmd_propose(args):
    """propose: a skill edit drafted from one failure a person's label confirms (grade/propose.py)."""
    d, sid, step, repo_dir, i = None, None, None, os.getcwd(), 0
    lab = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "grade", "labels")
    while i < len(args):
        a = args[i]
        if a in ("--session", "--step", "--labels", "--repo-dir") and i + 1 < len(args):
            if a == "--session":
                sid = args[i + 1]
            elif a == "--step":
                step = args[i + 1]
            elif a == "--labels":
                lab = args[i + 1]
            else:
                repo_dir = args[i + 1]
            i += 2
        elif d is None and not a.startswith("--"):
            d, i = a, i + 1
        else:
            say(PROPOSE_USAGE)
            return 2
    if not sid or not step:
        say(PROPOSE_USAGE)
        return 2
    fields, _, _ = load_grade_modules()
    import labels
    import propose
    if step not in fields.STEPS:
        say(f"no such step {step!r}: one of {', '.join(fields.STEPS)}")
        return 2
    try:
        d = folder_arg(d)
    except PermissionError as e:
        say(str(e))
        return 2
    entry = read_json(os.path.join(d, "sessions", sid + ".json"))
    try:
        if not isinstance(entry, dict):
            raise LookupError("it has no index entry")
        lines = session_lines(d, sid, entry)
    except (OSError, LookupError) as e:
        say(f"no such session in {d}: {sid} ({e})")
        return 1
    label = labels.load(lab)[0].get(sid)
    verdict, reason = (label["steps"].get(step) or (None, "")) if label else (None, "")
    if not label or verdict != labels.FAIL:  # a label with verdicts and no name is not loaded at all (labels.parse)
        say(f"no label confirms that {sid} failed {step}: a proposal is drafted only from a failure a person has labelled "
            f"(transcripts sheet, then the session's file in {os.path.abspath(lab)})")
        return 1
    if (label["sha256"], label["lines"]) != labels.transcript_hash(lines):
        say(f"the label of {sid} is of another version of the transcript: label this one before a proposal is drafted from it")
        return 1
    name, blob = change_skill(entry)
    if not any(sk.get("name") == name for sk in entry.get("skills") or []):
        say(f"{sid} did not load the change skill: an edit to the skill would not have reached that session")
        return 1
    # The version the session used, by its blob: from the repository, or the folder's own copy when that is the
    # same blob (materialize keeps one copy a skill, the newest session's). Another version is never taken for it.
    kept = os.path.join(d, "skills", name, "SKILL.md")
    current = git_blob(repo_dir, blob) if re.match(r"^[0-9a-f]{40}$", blob or "") else None
    if current is None and blob and blob_hash(kept) == blob:
        current = open(kept, "rb").read()
    if current is None:
        say(f"the skill file the session used ({name}, blob {(blob or 'unknown')[:12]}) is neither in {repo_dir} nor in {d}/skills")
        return 1
    current = current.decode("utf-8", "replace")
    out = os.path.join(d, "proposals", sid, step)
    sheet = labels.sheet(lines, sid, os.path.join(lab, sid + ".txt"), None, redact_text)
    got = propose.ask(propose.prompt_for(name, current, step, reason, sheet, redact_text))
    if got["status"] != "answer":
        say(f"no proposal: Claude {'refused' if got['status'] == 'refused' else 'gave no answer'} ({got['detail']})")
        return 1
    try:
        proposed, why, calls = propose.read_answer(got["answer"], current)
    except ValueError as e:
        say(f"no proposal: {e}")
        return 1
    write_atomic(os.path.join(out, "SKILL.md"), proposed.encode())
    write_atomic(os.path.join(out, "SKILL.diff"), propose.diff(current, proposed, name).encode())
    write_atomic(os.path.join(out, "proposal.md"), redact_text(
        propose.note(sid, step, name, blob, label["by"], reason, why, calls, got)).encode())
    write_atomic(os.path.join(out, "proposal.json"), (json.dumps({
        "session_id": sid, "step": step, "skill": name, "skill_blob": blob, "labelled_by": label["by"], "calls": calls,
        "eval": propose.cases(step), "proposer": propose.PROPOSE, "served_model": got["served_model"],
        "cost_usd": got["cost_usd"]}, indent=2) + "\n").encode())
    print(f"transcripts: a proposed edit to {name} is in {out}: SKILL.md, SKILL.diff and proposal.md; nothing else was changed")
    return 0


def cmd_report(args):
    d, store, lab, i = None, False, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "grade", "labels"), 0
    while i < len(args):
        if args[i] == "--store":
            store, i = True, i + 1
        elif args[i] == "--labels" and i + 1 < len(args):
            lab, i = args[i + 1], i + 2
        elif d is None and not args[i].startswith("--"):
            d, i = args[i], i + 1
        else:
            say("usage: transcripts report [DIR] [--store] [--labels DIR]")
            return 2
    _, judge, report = load_grade_modules()
    import labels
    try:  # the report only reads, so DIR may be anywhere, a repository's fixtures included
        d = os.path.abspath(d) if d else folder_arg(None)
        if not os.path.isdir(lab):
            raise PermissionError(f"no labels folder at {os.path.abspath(lab)}")
        url = key = None
        if store:
            url = store_url()
            if url is None:
                raise StoreError("--store needs AGENT_TRANSCRIPTS_URL, the store's URL")
            key = key_file("read-key", required=True)
    except (PermissionError, StoreError) as e:
        say(str(e))
        return 2
    rows, entries, judges, holds = [], {}, [], None
    for p in sorted(glob.glob(os.path.join(d, "scores", "*.json"))):
        got = read_json(p)
        rows += [r for r in got if isinstance(r, dict) and r.get("session_id")] if isinstance(got, list) else []
    for p in glob.glob(os.path.join(d, "sessions", "*.json")):
        e = read_json(p)
        if isinstance(e, dict) and e.get("session_id"):
            entries[e["session_id"]] = e
    for p in sorted(glob.glob(os.path.join(d, "judges", "*.json"))):
        j = read_json(p)
        if isinstance(j, dict) and j.get("session_id"):
            judges.append(j)

    def read(sid):  # a session's transcript as DIR holds it, or None; the store's rows bring none
        try:
            return session_lines(d, sid, read_json(os.path.join(d, "sessions", sid + ".json"), {}) or {})
        except (OSError, LookupError):
            return None
    here = {}
    for sid in sorted(set(entries) | {r["session_id"] for r in rows}):
        lines = read(sid)
        if lines is not None:
            here[sid] = labels.transcript_hash(lines)
    if store:
        try:
            rows += read_rows(url, key, "/rest/v1/scores?select=*&order=session_id,step,graded_at")
            for r in read_rows(url, key, "/rest/v1/sessions?select=session_id,entry&order=session_id,row_id"):
                entries.setdefault(r["session_id"], r.get("entry") or {})  # only the time is read
            judges += votes_to_judges(read_rows(url, key, "/rest/v1/judge_votes?select=session_id,question,judge,vote,status,verdict,reason,record_sha256,judged_at&order=session_id,question,judged_at,vote"), judge)
            holds = store_size(read_rows(url, key, "/rest/v1/chunks?select=session_id,bytes,redaction&order=session_id,stream,chunk_id"))
        except StoreError as e:
            say(str(e))
            return 1
    found, bad = labels.load(lab)
    for fname, why in bad:
        say(f"{os.path.join(lab, fname)}: {why}; the file is rejected")
    checked = {"labels": found, "problems": bad, "files": len(found) + len({n for n, _ in bad}), "here": here}
    proposals = sorted((x.get("session_id") or "", x.get("step") or "", x.get("eval")) for x in (
        read_json(p, {}) for p in glob.glob(os.path.join(d, "proposals", "*", "*", "proposal.json"))) if isinstance(x, dict))
    text = report.build(rows, entries, judges, checked, read, redact_text, skills_in, read_answers(d), proposals)
    if text is None:
        say(f"no score rows in {d}/scores" + (" or the store" if store else "") + " and no session in "
            f"{d}/sessions; run transcripts grade first")
        return 1
    if holds:  # under the title, where the owner reading the report sees it (concern C3 of 2026-11-15-user-level-capture)
        title, rest = text.split("\n", 1)
        text = f"{title}\n\n{holds}\n{rest}"
    sys.stdout.write(text)
    return 1 if bad else 0


def store_size(chunks):
    """One line: how many sessions and how much redacted text the store's chunk rows hold, by redaction version."""
    def some(rows):
        n = len({r["session_id"] for r in rows})
        return f"{n} session{'s' if n != 1 else ''} and {megabytes(sum(r.get('bytes') or 0 for r in rows))}"
    by = {}
    for r in chunks:
        by.setdefault(r.get("redaction"), []).append(r)
    parts = "; ".join(f"under redaction {v}, {some(by[v])}" for v in sorted(by, key=str))
    return f"The store holds {some(chunks)} of redacted text" + (f": {parts}." if parts else ".")


def votes_to_judges(votes, judge):
    """The store's judge_votes rows as judge files: per session, judge and run, the verdict of the votes."""
    runs = {}
    for v in votes:
        parts = str(v.get("judge") or "").split(":", 2)
        if len(parts) != 3:
            continue
        k = (v["session_id"], parts[1], v.get("judged_at"))
        j = runs.setdefault(k, {"session_id": v["session_id"], "judge": parts[0], "kind": parts[1], "model": parts[2],
                                "record_sha256": v.get("record_sha256"), "judged_at": v.get("judged_at"), "questions": {}})
        j["questions"].setdefault(v["question"], {"votes": []})["votes"].append(v)
    for j in runs.values():
        for q in j["questions"].values():
            q["verdict"] = judge.decide(q["votes"])[0]
    return list(runs.values())


def main(argv):
    os.umask(0o077)  # the archive is as private as Claude Code's own transcripts: owner only
    if argv[:1] == ["archive"]:
        return cmd_archive(argv[1:])
    if argv[:1] == ["import"]:
        return cmd_import(argv[1:])
    if argv[:1] == ["scope"]:
        return cmd_scope(argv[1:])
    if argv[:1] == ["push"]:
        return cmd_push(argv[1:])
    if argv[:1] == ["materialize"]:
        return cmd_materialize(argv[1:])
    if argv[:1] == ["messages"]:
        return cmd_messages(argv[1:])
    if argv[:1] == ["grade"]:
        return cmd_grade(argv[1:])
    if argv[:1] == ["sheet"]:
        return cmd_sheet(argv[1:])
    if argv[:1] == ["accuracy"]:
        return cmd_accuracy(argv[1:])
    if argv[:1] == ["judge"]:
        return cmd_judge(argv[1:])
    if argv[:1] == ["propose"]:
        return cmd_propose(argv[1:])
    if argv[:1] == ["report"]:
        return cmd_report(argv[1:])
    if argv[:1] == ["probe"]:
        sys.dont_write_bytecode = True  # no __pycache__ beside the plugin's code
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "probe"))
        import agent_sample
        return agent_sample.main(argv[1:])
    if argv[:1] == ["redact"]:
        data = sys.stdin.buffer.read()  # all of it first: an id may be used above the line that names it
        learn_ids(data)
        for raw in data.splitlines(keepends=True):
            sys.stdout.buffer.write(redact_line(raw))
        return 0
    print(__doc__.strip().split("\n\n")[0], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
