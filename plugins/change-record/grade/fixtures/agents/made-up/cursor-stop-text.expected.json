      "status": "string:1",
      "transcript_path": "string:1",
      "user_email": "string:1",
      "workspace_roots": "array:1",
      "workspace_roots[]": "string:1"
    },
    "values": {
      "cursor_version": {
        "2.1.321": 1
      },
      "hook_event_name": {
        "stop": 1
      },
      "model": {
        "claude-4.5-sonnet": 1
      },
      "status": {
        "completed": 1
      }
    }
  },
  "probe": 1,
  "transcript": {
    "blank_lines": 2,
    "bytes": 227,
